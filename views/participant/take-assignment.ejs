<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title><%= assignment.title %></title>
    <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .gradient-text {
      background: linear-gradient(135deg, #4f46e5, #9333ea, #ec4899);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .loader-ring {
      display: inline-block;
      width: 48px;
      height: 48px;
      border: 4px solid rgba(234, 179, 8, 0.2);
      border-radius: 50%;
      border-top-color: #eab308;
      animation: spin 1s ease-in-out infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-purple-950 to-indigo-950 min-h-screen p-6">

  <div id="card" class="max-w-2xl mx-auto bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-8 shadow-2xl">
    <h2 class="text-white text-2xl font-bold mb-2"><%= assignment.title %></h2>
    <p class="text-gray-400 mb-6"><%= assignment.description %></p>

    <% if (alreadySubmitted && mySubmission) { %>
      <% if (mySubmission.isGraded) { %>
        <div class="bg-gradient-to-br from-green-500/20 to-emerald-500/10 border border-green-500/40 rounded-xl p-8 text-center">
          <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="award" class="text-green-400 w-8 h-8"></i>
          </div>
          <h3 class="text-white text-xl font-bold mb-1">Graded ✅</h3>
          <p class="text-gray-400 text-sm mb-4">Here's how you did</p>
          <div class="text-5xl font-extrabold gradient-text mb-2">
            <%= mySubmission.totalScore %> <span class="text-2xl text-gray-400">/ <%= mySubmission.maxScore %></span>
          </div>
          <p class="text-gray-400 text-sm">
            <%= Math.round((mySubmission.totalScore / (mySubmission.maxScore || 1)) * 100) %>% score
            <% if (mySubmission.gradedAt) { %> • Graded <%= new Date(mySubmission.gradedAt).toLocaleDateString() %><% } %>
          </p>

          <div class="mt-6 space-y-2 text-left">
            <% mySubmission.answers.forEach((ans) => {
              const q = assignment.questions[ans.questionIndex];
            %>
              <div class="bg-black/20 rounded-lg p-3 flex items-start justify-between gap-3">
                <div>
                  <p class="text-white text-sm">Q<%= ans.questionIndex + 1 %>. <%= q ? q.questionText : '' %></p>
                  <p class="text-gray-500 text-xs mt-1">Your answer: <%= ans.answerText %></p>
                </div>
                <span class="shrink-0 text-xs px-2 py-1 rounded-full <%= ans.isCorrect ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400' %>">
                  <%= ans.pointsAwarded %>/<%= q ? q.points : 0 %>
                </span>
              </div>
            <% }) %>
          </div>

          <a href="/assignment/my-assignments" class="inline-block mt-6 text-indigo-300 text-sm hover:underline">← Back to Assignments</a>
        </div>
      <% } else { %>
        <div class="bg-yellow-500/20 border border-yellow-500 rounded-xl p-8 text-center">
          <div class="loader-ring mx-auto mb-4"></div>
          <h3 class="text-white text-lg font-bold mb-1">Submitted — Awaiting Grading</h3>
          <p class="text-yellow-300 text-sm">Your coding answer needs manual review by your teacher. You'll get a notification the moment it's graded.</p>
          <a href="/assignment/my-assignments" class="inline-block mt-6 text-indigo-300 text-sm hover:underline">← Back to Assignments</a>
        </div>
      <% } %>
    <% } else { %>
      <form id="assignmentForm" action="/assignment/submit/<%= assignment._id %>" method="POST" enctype="multipart/form-data">
        <div class="space-y-5">
          <% assignment.questions.forEach((q, i) => { %>
            <div class="bg-black/30 rounded-xl p-4">
              <p class="text-white font-semibold mb-2">Q<%= i+1 %>. <%= q.questionText %> <span class="text-gray-500 text-xs">(<%= q.points %> pts)</span></p>
              <% if (q.questionImage) { %><img src="<%= q.questionImage %>" class="rounded-lg mb-3 max-h-48 object-contain" /><% } %>

              <% if (q.type === "mcq") { %>
                <div class="grid gap-2">
                  <% q.options.forEach((opt, oi) => { %>
                    <label class="flex items-center gap-3 bg-white/5 hover:bg-white/10 rounded-lg p-2 cursor-pointer">
                      <input type="radio" name="q<%= i %>" value="<%= opt %>" class="answer-input" data-index="<%= i %>" />
                      <% if (q.optionImages && q.optionImages[oi]) { %><img src="<%= q.optionImages[oi] %>" class="w-12 h-12 object-cover rounded" /><% } %>
                      <span class="text-gray-200 text-sm"><%= opt %></span>
                    </label>
                  <% }) %>
                </div>
              <% } else if (q.type === "true_false") { %>
                <div class="flex gap-4">
                  <label class="text-gray-200 text-sm flex items-center gap-2"><input type="radio" name="q<%= i %>" value="True" class="answer-input" data-index="<%= i %>" /> True</label>
                  <label class="text-gray-200 text-sm flex items-center gap-2"><input type="radio" name="q<%= i %>" value="False" class="answer-input" data-index="<%= i %>" /> False</label>
                </div>
              <% } else if (q.type === "coding") { %>
                <p class="text-gray-500 text-xs mb-1">Language: <%= q.codeLanguage || "Any" %></p>
                <textarea name="q<%= i %>" rows="8" class="answer-input w-full bg-black/50 text-green-300 font-mono text-sm rounded-lg p-3" data-index="<%= i %>"><%= q.starterCode || "" %></textarea>
              <% } else { %>
                <input type="text" name="q<%= i %>" class="answer-input w-full bg-white/10 text-white text-sm rounded-lg p-3" data-index="<%= i %>" placeholder="Your answer" />
              <% } %>
            </div>
          <% }) %>

          <div>
            <label class="text-gray-300 text-sm">Attach File (optional)</label>
            <input type="file" name="fileUpload" class="w-full bg-white/10 text-white text-sm rounded-lg p-2 mt-1" />
          </div>

          <input type="hidden" name="answers" id="answersInput" />

          <button type="submit" onclick="return buildAnswers()"
            class="w-full bg-gradient-to-r from-indigo-500 to-purple-600 text-white py-3 rounded-xl font-semibold hover:scale-105 transition">
            Submit Assignment
          </button>
        </div>
      </form>
    <% } %>
  </div>

  <script>
    lucide.createIcons();
    gsap.from("#card", { opacity: 0, y: 30, duration: 0.7 });

    function buildAnswers() {
      const answers = [];
      document.querySelectorAll(".answer-input").forEach((input) => {
        const index = Number(input.dataset.index);
        if (input.type === "radio") {
          if (input.checked) answers[index] = { questionIndex: index, answerText: input.value };
        } else {
          answers[index] = { questionIndex: index, answerText: input.value };
        }
      });
      document.getElementById("answersInput").value = JSON.stringify(answers.filter(Boolean));
      return true;
    }
  </script>
</body>
</html>