<%- include('../partials/shell-top', { role: 'host', active: 'assignments', title: 'Results' }) %>
<%
  const J = v => JSON.stringify(v).replace(/</g, '\\u003c');
  const subs = assignment.submissions;
  const pcts = subs.map(s => s.maxScore ? Math.round(s.totalScore / s.maxScore * 100) : 0);
  const avg = pcts.length ? Math.round(pcts.reduce((a, b) => a + b, 0) / pcts.length) : 0;
  const hi = pcts.length ? Math.max.apply(null, pcts) : 0;
  const pass = pcts.length ? Math.round(pcts.filter(p => p >= 50).length / pcts.length * 100) : 0;
  const ranked = subs.map((s, i) => ({ s: s, p: pcts[i] })).sort((a, b) => b.p - a.p);
  const cards = [['inbox', 'Submissions', subs.length, ''], ['percent', 'Average', avg, '%'], ['trophy', 'Highest', hi, '%'], ['badge-check', 'Pass rate (≥50%)', pass, '%']];
%>
<a class="link" href="/host/assignments">← Back to assignments</a>
<div class="page-head mt-s">
  <div><span class="badge b-accent"><%= assignment.type.replace('_', ' ') %></span><h2><%= assignment.title %> — results</h2></div>
  <a class="btn btn-primary" href="/assignment/grade/<%= assignment._id %>"><i data-lucide="pen-line"></i> Grade submissions</a>
</div>

<section class="grid g4 mb">
  <% cards.forEach(c => { %><div class="card stat reveal"><span class="ico"><i data-lucide="<%= c[0] %>"></i></span><b><span data-count="<%= c[2] %>">0</span><%= c[3] %></b><span class="muted small"><%= c[1] %></span></div><% }) %>
</section>

<div class="card mb reveal"><div class="card-h"><h3>Scores by student</h3></div><div class="chart"><canvas id="scoreChart"></canvas></div></div>

<div class="card reveal">
  <div class="card-h"><h3>Ranking</h3></div>
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th>#</th><th>Student</th><th>Score</th><th>%</th><th>Status</th><th>Submitted</th></tr></thead>
    <tbody>
      <% ranked.forEach((r, i) => { %>
        <tr><td><b><%= i + 1 %></b></td><td><%= r.s.participantName %></td><td><%= r.s.totalScore %>/<%= r.s.maxScore %></td>
          <td><span class="badge <%= r.p >= 75 ? 'b-green' : r.p >= 50 ? 'b-amber' : 'b-red' %>"><%= r.p %>%</span></td>
          <td><%= r.s.isGraded ? 'Graded' : 'Needs grading' %></td><td class="muted small"><%= new Date(r.s.submittedAt).toLocaleString() %></td></tr>
      <% }) %>
      <% if (!ranked.length) { %><tr><td colspan="6" class="empty-s">No submissions yet</td></tr><% } %>
    </tbody>
  </table></div>
</div>

<script>
(function () {
  var el = document.getElementById('scoreChart'); if (!el || !window.Chart) return;
  new Chart(el, { type: 'bar', data: { labels: <%- J(subs.map(s => s.participantName)) %>, datasets: [{ data: <%- J(pcts) %>, backgroundColor: cssVar('--a1'), borderRadius: 8, maxBarThickness: 36 }] },
    options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { min: 0, max: 100, ticks: { callback: function (v) { return v + '%'; } } }, x: { grid: { display: false } } } } });
})();
</script>
<%- include('../partials/shell-bottom') %>