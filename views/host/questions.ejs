<%- include('../partials/shell-top', { role: 'host', active: 'questions', title: 'Question bank' }) %>
<div class="page-head">
  <div><span class="badge b-accent">Assess</span><h2>Question bank</h2><p class="muted"><%= bank.length %> questions across <%= sets %> assignment<%= sets === 1 ? '' : 's' %>. To ask one live, open it in the room's Q&amp;A panel.</p></div>
  <a class="btn btn-primary" href="/assignment/create"><i data-lucide="plus"></i> New question set</a>
</div>

<section class="grid g4 mb">
  <% [['mcq','list-checks','Multiple choice'],['true_false','toggle-left','True / False'],['short_answer','text-cursor-input','Short answer'],['coding','code-2','Coding']].forEach(t => { %>
    <div class="card stat"><span class="ico"><i data-lucide="<%= t[1] %>"></i></span><b><%= counts[t[0]] || 0 %></b><span class="muted small"><%= t[2] %></span></div>
  <% }) %>
</section>

<div class="toolbar">
  <div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#qbList" placeholder="Search questions…" /></div>
  <div class="tabs" data-filter-for="#qbList"><button class="on" data-f="all">All</button><button data-f="mcq">MCQ</button><button data-f="true_false">T/F</button><button data-f="short_answer">Short</button><button data-f="coding">Coding</button></div>
</div>

<div class="card" id="qbList" data-list>
  <% bank.forEach(b => { %>
    <a class="item" data-item data-status="<%= b.type %>" href="/assignment/grade/<%= b.setId %>">
      <span class="badge b-accent"><%= b.type.replace('_', ' ') %></span>
      <div class="grow"><b class="truncate" style="display:block"><%= b.text %></b><span class="muted small">in “<%= b.set %>”</span></div>
      <span class="badge"><%= b.points %> pt<%= b.points > 1 ? 's' : '' %></span>
    </a>
  <% }) %>
</div>
<div class="empty" data-empty-for="#qbList" <%= bank.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="help-circle"></i></div>No questions yet.</div>
<%- include('../partials/shell-bottom') %>