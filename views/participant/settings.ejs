<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>Settings</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="relative min-h-screen">
   
    <!-- TOP NOTIFICATION BELL -->
  <div class="fixed top-4 right-6 z-30">
 <!-- ✅ FIXED -->
<%- include('../partials/notification-bell', { userId: user._id }) %>
<%- include('../partials/live-meeting-alert') %>
</div>

  <%- include('../partials/sidebar', { role: user.role, active: 'settings' }) %>

  <main class="ml-64 p-8 relative z-10">
    <h1 class="text-white text-3xl font-bold mb-6">⚙️ Account Settings</h1>

    <div class="glass-card p-8 max-w-lg">
      <% if (message) { %>
        <div class="bg-green-500/20 border border-green-500 text-green-300 px-4 py-2 rounded-lg mb-4 text-sm"><%= message %></div>
      <% } %>
      <% if (error) { %>
        <div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-2 rounded-lg mb-4 text-sm"><%= error %></div>
      <% } %>

      <form action="/<%= user.role %>/settings" method="POST" class="space-y-4">
        <div>
          <label class="text-gray-300 text-xs mb-1 block">Full Name</label>
          <input type="text" name="name" value="<%= user.name %>" required
            class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3" />
        </div>
        <div>
          <label class="text-gray-300 text-xs mb-1 block">Email</label>
          <input type="email" name="email" value="<%= user.email %>" required
            class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3" />
        </div>
        <button type="submit" class="btn-glow w-full text-white py-3 rounded-xl font-semibold">Save Changes</button>
      </form>
    </div>
  </main>
  <script>lucide.createIcons();</script>
</body>
</html>