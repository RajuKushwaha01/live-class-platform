<!DOCTYPE html>
<html lang="en">
<head>
  <title>Create account · EduLive</title>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="blob blob-1"></div><div class="blob blob-2"></div>
  <main class="relative z-10 min-h-screen flex items-center justify-center p-5 sm:p-10">
    <div class="glass-card w-full max-w-md p-7 sm:p-9" data-reveal>
      <a href="/" class="flex items-center gap-2 font-display font-bold text-lg mb-6"><span class="logo-mark">E</span> EduLive</a>

      <div class="grid grid-cols-2 gap-1 p-1 rounded-2xl mb-7" style="background:rgba(255,255,255,.05);border:1px solid var(--line)">
        <a href="/auth/register?portal=student" class="text-center text-sm py-2.5 rounded-xl <%= portal==='student' ? 'btn-glow' : 'text-gray-400' %>">🎓 Student</a>
        <a href="/auth/register?portal=teacher" class="text-center text-sm py-2.5 rounded-xl <%= portal==='teacher' ? 'btn-glow' : 'text-gray-400' %>">🧑‍🏫 Teacher</a>
      </div>

      <h2 class="text-2xl font-bold">Create your <%= portal %> account</h2>
      <p class="text-gray-400 text-sm mt-1 mb-6">
        <%= portal === 'teacher' ? 'Host live classes and grade your students.' : 'Join classes and track your marks.' %>
      </p>

      <% if (error) { %>
        <div class="rounded-xl px-4 py-3 mb-4 text-sm" style="background:rgba(251,113,133,.12);border:1px solid rgba(251,113,133,.4);color:#fda4af"><%= error %></div>
      <% } %>

      <form action="/auth/register" method="POST" class="space-y-4">
        <input type="hidden" name="portal" value="<%= portal %>" />
        <div>
          <label class="text-xs text-gray-400 mb-1.5 block">Full name</label>
          <input type="text" name="name" required placeholder="Your name" class="w-full px-4 py-3" />
        </div>
        <div>
          <label class="text-xs text-gray-400 mb-1.5 block">Email</label>
          <input type="email" name="email" required placeholder="you@example.com" class="w-full px-4 py-3" />
        </div>
        <div>
          <label class="text-xs text-gray-400 mb-1.5 block">Password</label>
          <div class="relative">
            <input id="regPass" type="password" name="password" required minlength="6" placeholder="At least 6 characters" class="w-full px-4 py-3 pr-12" />
            <button type="button" data-toggle-pass="regPass" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white"><i data-lucide="eye" class="w-4 h-4"></i></button>
          </div>
        </div>
        <% if (portal === 'teacher' && needsCode) { %>
          <div>
            <label class="text-xs text-gray-400 mb-1.5 block">Teacher access code</label>
            <input type="text" name="teacherCode" required placeholder="Given by your institution" class="w-full px-4 py-3" />
          </div>
        <% } %>
        <button type="submit" class="btn-glow w-full py-3.5">Create account <i data-lucide="arrow-right" class="w-4 h-4"></i></button>
      </form>

      <p class="text-center text-sm text-gray-400 mt-6">Already registered? <a href="/auth/login?portal=<%= portal %>" style="color:var(--accent)" class="font-medium">Sign in</a></p>
    </div>
  </main>
  <%- include('../partials/foot') %>
</body>
</html>