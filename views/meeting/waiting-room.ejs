<!DOCTYPE html>
<html lang="en" class="js" data-role="<%= user.role %>">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Waiting room · EduLive</title>
  <script>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'dark'}catch(e){document.documentElement.dataset.theme='dark'}</script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
  <style>.spin{width:56px;height:56px;border-radius:50%;border:5px solid var(--a-soft);border-top-color:var(--a1);animation:sp 1s linear infinite;margin:0 auto 18px}@keyframes sp{to{transform:rotate(360deg)}}</style>
</head>
<body>
  <div class="center-screen">
    <div class="card center" style="max-width:440px;width:100%;padding:38px 28px">
      <div class="spin" id="spin"></div>
      <h2 style="font-size:22px;font-weight:800" id="wTitle">You're in the waiting room</h2>
      <p class="muted mt-s"><%= meeting.title %></p>
      <p class="muted small mt-s" id="wMsg">Waiting for <b style="color:var(--text)"><%= meeting.host.name %></b> to let you in…</p>
      <a class="btn btn-ghost mt" href="/participant/dashboard">Leave</a>
    </div>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    var socket = io();
    socket.emit("join-room", { meetingCode: "<%= meeting.meetingCode %>" });
    function stop(title, msg) {
      document.getElementById("spin").style.display = "none";
      document.getElementById("wTitle").textContent = title;
      document.getElementById("wMsg").textContent = msg;
    }
    socket.on("admitted", function () { location.href = "/meeting/room/<%= meeting.meetingCode %>"; });
    socket.on("denied", function () { stop("Request declined", "The teacher did not admit you to this class."); });
    socket.on("meeting-ended", function () { stop("Class ended", "This class has ended."); });
    socket.on("room-error", function (d) { stop("Can't join", d.message); });
    // If the teacher turned the waiting room off, the server lets you straight in.
    socket.on("room-joined", function () { location.href = "/meeting/room/<%= meeting.meetingCode %>"; });
  </script>
</body>
</html>