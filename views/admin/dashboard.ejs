<%- include('../partials/shell-top', { role: 'admin', active: 'dashboard', title: 'Admin dashboard' }) %>
<%
  const J = v => JSON.stringify(v).replace(/</g, '\\u003c');
  const cards = [
    ['users', 'Total users', stats.users, ''],
    ['graduation-cap', 'Teachers', stats.hosts, ''],
    ['radio', 'Live right now', stats.live, ''],
    ['video', 'Total meetings', stats.meetings, '']
  ];
  const up = Math.floor(health.uptime), uptxt = Math.floor(up / 3600) + 'h ' + Math.floor((up % 3600) / 60) + 'm';
  const memPct = Math.min(100, Math.round(health.memMB / 10));
%>
<section class="hero on-grad reveal">
  <div class="grow">
    <span class="hero-tag">Control panel</span>
    <h2>Platform overview</h2>
    <p><%= stats.students %> students, <%= stats.hosts %> teachers and <%= stats.assignments %> assignments. <%= stats.blocked ? stats.blocked + ' account(s) blocked.' : 'No blocked accounts.' %></p>
    <div class="row wrap mt-s">
      <a class="btn btn-white" href="/admin/live-monitor"><span class="live-dot"></span> Live monitor</a>
      <a class="btn btn-ghost" href="/admin/users"><i data-lucide="users"></i> Manage users</a>
    </div>
  </div>
</section>

<section class="grid g4 mt">
  <% cards.forEach((c, i) => { %>
    <div class="card stat reveal" style="transition-delay:<%= i * 70 %>ms"><span class="ico"><i data-lucide="<%= c[0] %>"></i></span><b><span data-count="<%= c[2] %>">0</span></b><span class="muted small"><%= c[1] %></span></div>
  <% }) %>
</section>

<section class="grid g-main mt">
  <div class="col">
    <div class="card reveal">
      <div class="card-h"><h3>Growth — last 7 days</h3><span class="muted small">Sign-ups &amp; meetings</span></div>
      <div class="chart"><canvas id="growthChart"></canvas></div>
    </div>

    <div class="card reveal">
      <div class="card-h"><h3>Recent meetings</h3><a class="link" href="/admin/meetings">View all →</a></div>
      <% recentMeetings.forEach(m => { %>
        <div class="item"><span class="ico"><i data-lucide="video"></i></span>
          <div class="grow"><b class="truncate" style="display:block"><%= m.title %></b><span class="muted small">Host: <%= m.host ? m.host.name : '—' %> · <%= m.participants.length %> joined</span></div>
          <span class="badge <%= m.status === 'live' ? 'b-red' : m.status === 'ended' ? '' : 'b-amber' %>"><%= m.status %></span></div>
      <% }) %>
      <% if (!recentMeetings.length) { %><div class="empty-s">No meetings yet</div><% } %>
    </div>
  </div>

  <div class="col">
    <div class="card reveal">
      <div class="card-h"><h3>User roles</h3></div>
      <div class="chart" style="height:200px"><canvas id="roleChart"></canvas></div>
    </div>

    <div class="card reveal">
      <div class="card-h"><h3>System health</h3><span class="badge <%= health.db ? 'b-green' : 'b-red' %>"><%= health.db ? 'Healthy' : 'DB down' %></span></div>
      <div class="col" style="gap:12px">
        <div class="row between"><span class="muted">Database</span><b><%= health.db ? 'Connected' : 'Disconnected' %></b></div>
        <div class="row between"><span class="muted">Uptime</span><b><%= uptxt %></b></div>
        <div class="row between"><span class="muted">Live connections</span><b><%= health.sockets %></b></div>
        <div><div class="row between small"><span class="muted">Memory</span><b><%= health.memMB %> MB</b></div><div class="progress mt-s"><i style="width:<%= memPct %>%"></i></div></div>
      </div>
    </div>

    <div class="card reveal">
      <div class="card-h"><h3>Newest users</h3><a class="link" href="/admin/users">All →</a></div>
      <% recentUsers.forEach(u => { %>
        <div class="item"><span class="avatar" style="width:34px;height:34px;border-radius:10px"><%= (u.name || '?').slice(0, 1).toUpperCase() %></span>
          <div class="grow"><b class="truncate" style="display:block"><%= u.name %></b><span class="muted small truncate" style="display:block"><%= u.email %></span></div>
          <span class="badge b-accent"><%= u.role === 'participant' ? 'student' : u.role === 'host' ? 'teacher' : 'admin' %></span></div>
      <% }) %>
    </div>
  </div>
</section>

<script>
(function () {
  if (!window.Chart) return;
  var a1 = cssVar('--a1'), a2 = cssVar('--a2');
  new Chart(document.getElementById('growthChart'), { type: 'line',
    data: { labels: <%- J(labels) %>, datasets: [
      { label: 'New users', data: <%- J(regs) %>, borderColor: a1, backgroundColor: a1 + '22', fill: true, tension: .4, pointRadius: 3 },
      { label: 'Meetings', data: <%- J(mtgs) %>, borderColor: a2, backgroundColor: a2 + '22', fill: true, tension: .4, pointRadius: 3 }] },
    options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { grid: { display: false } } } } });
  new Chart(document.getElementById('roleChart'), { type: 'doughnut',
    data: { labels: ['Students', 'Teachers', 'Admins'], datasets: [{ data: [<%= stats.students %>, <%= stats.hosts %>, <%= stats.admins %>], backgroundColor: [a1, a2, '#8d99c0'], borderWidth: 0 }] },
    options: { maintainAspectRatio: false, cutout: '68%', plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } } } });
})();
</script>
<%- include('../partials/shell-bottom') %>