<%- include('../partials/shell-top', { role: 'participant', active: 'assignments', title: 'Tasks' }) %>
<% const cnt = s => assignments.filter(a => a.state === s).length; %>
<div class="page-head"><div><span class="badge b-accent">Tasks</span><h2>My tasks</h2><p class="muted">Quizzes, homework and coding challenges from your teachers.</p></div></div>

<div class="toolbar">
  <div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#tList" placeholder="Search tasks…" /></div>
  <div class="tabs" data-filter-for="#tList">
    <button class="on" data-f="all">All <%= assignments.length %></button>
    <button data-f="todo">To do <%= cnt('todo') %></button>
    <button data-f="review">In review <%= cnt('review') %></button>
    <button data-f="graded">Graded <%= cnt('graded') %></button>
  </div>
</div>

<div class="grid g-auto" id="tList" data-list>
  <% assignments.forEach(a => {
    const pct = a.mine && a.mine.maxScore ? Math.round(a.mine.totalScore / a.mine.maxScore * 100) : 0;
  %>
    <article class="card hover" data-item data-status="<%= a.state %>">
      <div class="row between">
        <span class="badge b-accent"><%= a.type.replace('_', ' ') %></span>
        <% if (a.state === 'graded') { %><span class="badge b-green">Graded</span>
        <% } else if (a.state === 'review') { %><span class="badge b-amber">In review</span>
        <% } else if (a.overdue) { %><span class="badge b-red">Overdue</span>
        <% } else { %><span class="badge">To do</span><% } %>
      </div>
      <h3 class="mt-s"><%= a.title %></h3>
      <p class="muted small"><%= a.questions.length %> questions<%= a.dueDate ? ' · due ' + new Date(a.dueDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) : '' %></p>
      <% if (a.state === 'graded') { %>
        <div class="mt-s"><div class="row between small"><span class="muted">Your score</span><b><%= a.mine.totalScore %>/<%= a.mine.maxScore %> · <%= pct %>%</b></div><div class="progress mt-s"><i style="width:<%= pct %>%"></i></div></div>
      <% } %>
      <div class="mt"><a class="btn <%= a.state === 'todo' ? 'btn-primary' : 'btn-ghost' %> btn-block" href="/assignment/take/<%= a._id %>"><%= a.state === 'todo' ? 'Start task' : 'View result' %></a></div>
    </article>
  <% }) %>
</div>
<div class="empty" data-empty-for="#tList" <%= assignments.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="clipboard-check"></i></div>No tasks here yet.</div>
<%- include('../partials/shell-bottom') %>