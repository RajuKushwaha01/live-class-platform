<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Error</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/responsive.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css" />
</head>
<body class="relative min-h-screen flex items-center justify-center px-6">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <div class="glass-card p-10 max-w-md w-full text-center relative z-10">
    <div class="w-16 h-16 bg-red-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
      <span class="text-3xl">⚠️</span>
    </div>
    <h2 class="text-white text-xl font-bold mb-2">Something Went Wrong</h2>
    <p class="text-gray-400 mb-6"><%= message %></p>
    <a href="/" class="btn-glow inline-block text-white px-6 py-3 rounded-xl font-semibold">Go Home</a>
  </div>
</body>
</html>