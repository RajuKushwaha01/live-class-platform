<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
   <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>Create Meeting</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/animations.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <style>
    /* ⭐ FALLBACK — guarantees color even if Tailwind CDN is slow/blocked */
    body {
      background: #05060f;
      background: linear-gradient(135deg, #1e1b4b 0%, #0f0a2e 50%, #05060f 100%);
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      color: #f1f5f9;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-indigo-950 via-purple-900 to-slate-900 min-h-screen flex items-center justify-center p-6 form-page-padding">

  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <% if (typeof createdMeeting !== "undefined" && createdMeeting) { %>
    <div id="successCard" class="glass-card p-10 max-w-lg w-full text-center shadow-2xl relative z-10" style="background: rgba(255,255,255,0.08); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.15);">
      <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
        <i data-lucide="check-circle" class="text-green-400 w-8 h-8"></i>
      </div>
      <h2 class="text-white text-2xl font-bold mb-2">Meeting Created!</h2>
      <p class="text-gray-300 mb-6"><%= createdMeeting.title %></p>

      <div class="bg-black/30 rounded-xl p-4 mb-4 flex items-center justify-between">
        <span class="text-indigo-300 font-mono text-lg"><%= createdMeeting.meetingCode %></span>
        <button onclick="copyLink()" class="text-white bg-indigo-600 hover:bg-indigo-500 px-3 py-1 rounded-lg text-sm transition">Copy Link</button>
      </div>
      <input id="meetingLink" type="hidden" value="/meeting/<%= createdMeeting.meetingCode %>" />

      <a href="/meeting/room/<%= createdMeeting.meetingCode %>" class="btn-glow block w-full text-white py-3 rounded-xl font-semibold">
        Enter Meeting Room →
      </a>
      <a href="/host/dashboard" class="block mt-3 text-gray-400 hover:text-white text-sm">Back to Dashboard</a>
    </div>

  <% } else { %>
    <div id="formCard" class="glass-card p-10 max-w-xl w-full shadow-2xl relative z-10" style="background: rgba(255,255,255,0.08); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.15); border-radius: 20px;">
      <h2 class="text-white text-3xl font-bold mb-2">Create New Meeting</h2>
      <p class="text-gray-400 mb-6">Fill details to generate your class link</p>

      <% if (error) { %>
        <div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-2 rounded-lg mb-4"><%= error %></div>
      <% } %>

      <form action="/meeting/create" method="POST" class="space-y-4">
        <input type="text" name="title" placeholder="Meeting Title" required
          class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff;" />

        <input type="text" name="chapterName" placeholder="Chapter / Topic Name" required
          class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff;" />

        <textarea name="description" placeholder="Description" rows="2"
          class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff;"></textarea>

        <div class="grid grid-cols-2 gap-4">
          <input type="date" name="scheduledDate" required
            class="bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; color-scheme: dark;" />
          <input type="time" name="startTime" required
            class="bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; color-scheme: dark;" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <input type="number" name="duration" placeholder="Duration (minutes)" required
            class="bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff;" />
          <input type="number" name="maxParticipants" placeholder="Max Participants"
            class="bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff;" />
        </div>

        <input type="password" name="meetingPassword" placeholder="Meeting Password (optional)"
          class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff;" />

        <button type="submit" class="btn-glow w-full text-white py-3 rounded-xl font-semibold"
          style="background: linear-gradient(135deg, #818cf8, #c084fc); border: none; cursor: pointer;">
          Create Meeting & Generate Link
        </button>
      </form>
    </div>
  <% } %>

  <script>
    lucide.createIcons();
    if (typeof gsap !== "undefined") {
      gsap.from("#formCard, #successCard", { opacity: 0, y: 40, duration: 0.8, ease: "power3.out" });
    }

    function copyLink() {
      const link = window.location.origin + document.getElementById("meetingLink").value;
      navigator.clipboard.writeText(link);
      alert("Link copied: " + link);
    }
  </script>
</body>
</html>