<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Materials</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="relative min-h-screen">
  
     <!-- TOP NOTIFICATION BELL -->
  <div class="fixed top-4 right-6 z-30">
 <!-- ✅ FIXED -->
<%- include('../partials/notification-bell', { userId: user._id }) %>
<%- include('../partials/live-meeting-alert') %>
</div>


  <%- include('../partials/sidebar', { role: role, active: 'materials' }) %>

  <main class="ml-64 p-8 relative z-10">
    <h1 class="text-white text-3xl font-bold mb-6">📚 Chapter Materials</h1>

    <div class="grid md:grid-cols-2 gap-5">
      <% chapters.forEach(c => { %>
        <div class="glass-card card-3d p-5">
          <h3 class="text-white font-semibold mb-1"><%= c.title %></h3>
          <p class="text-gray-400 text-sm mb-3"><%= c.meeting ? c.meeting.title : '' %></p>
          <p class="text-gray-300 text-sm mb-3 line-clamp-2"><%= c.explanation %></p>
          <div class="flex gap-2 flex-wrap">
            <% if (c.pdfFile) { %>
              <a href="<%= c.pdfFile %>" target="_blank" class="bg-white/10 text-white text-xs px-3 py-1.5 rounded-lg flex items-center gap-1">
                <i data-lucide="file-text" class="w-3 h-3"></i> PDF
              </a>
            <% } %>
            <% if (c.videoUrl) { %>
              <a href="<%= c.videoUrl %>" target="_blank" class="bg-white/10 text-white text-xs px-3 py-1.5 rounded-lg flex items-center gap-1">
                <i data-lucide="play-circle" class="w-3 h-3"></i> Video
              </a>
            <% } %>
            <% c.images.forEach(img => { %>
              <a href="<%= img %>" target="_blank" class="bg-white/10 text-white text-xs px-3 py-1.5 rounded-lg">🖼 Image</a>
            <% }) %>
          </div>
        </div>
      <% }) %>
      <% if (chapters.length === 0) { %>
        <p class="text-gray-500 col-span-2 text-center py-10">No materials published yet.</p>
      <% } %>
    </div>
  </main>
  <script>lucide.createIcons();</script>
</body>
</html>