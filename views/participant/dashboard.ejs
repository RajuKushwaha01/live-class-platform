<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Student Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/responsive.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/animations.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body class="relative min-h-screen">
  <!-- TOP NOTIFICATION BELL -->
  <div class="fixed top-4 right-6 z-30">
    <!-- ✅ FIXED -->
  <%- include('../partials/notification-bell', { userId: user._id }) %>
  </div>

  <div class="blob blob-1"></div>
  <div class="blob blob-3"></div>

  <%- include('../partials/sidebar', { role: 'participant', active: 'dashboard' }) %>
<%- include('../partials/live-meeting-alert') %>
  <main class="main-content ml-64 p-4 md:p-8 relative z-10 page-fade-in">
    <h1 class="text-white text-3xl font-bold mb-1">Welcome back, <%= user.name %> 👋</h1>
    <p class="text-gray-400 mb-8">Ready to continue learning?</p>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-5 mb-10">
      <div class="stat-card glass-card card-3d p-5">
        <i data-lucide="calendar" class="text-indigo-300 mb-2"></i>
        <p class="text-3xl font-bold text-white count-up" data-target="<%= upcoming.length %>">0</p>
        <p class="text-gray-400 text-sm">Upcoming Classes</p>
      </div>
      <div class="stat-card glass-card card-3d p-5">
        <i data-lucide="clipboard-check" class="text-purple-300 mb-2"></i>
        <p class="text-3xl font-bold text-white count-up" data-target="8">0</p>
        <p class="text-gray-400 text-sm">Assignments Done</p>
      </div>
      <div class="stat-card glass-card card-3d p-5">
        <i data-lucide="award" class="text-pink-300 mb-2"></i>
        <p class="text-3xl font-bold text-white count-up" data-target="92">0</p>
        <p class="text-gray-400 text-sm">Avg. Score %</p>
      </div>
    </div>

    <div class="glass-card p-6">
      <h3 class="text-white font-semibold text-lg mb-4">📅 Upcoming Meetings</h3>
      <div class="space-y-3">
        <% upcoming.forEach(m => { %>
          <div class="flex items-center justify-between bg-white/5 rounded-xl p-4 hover:bg-white/10 transition">
            <div>
              <p class="text-white font-medium"><%= m.title %></p>
              <p class="text-gray-400 text-xs"><%= m.chapterName || '' %></p>
            </div>
            <a href="/meeting/<%= m.meetingCode %>" class="btn-glow text-white text-xs px-4 py-2 rounded-lg">Join →</a>
          </div>
        <% }) %>
        <% if (upcoming.length === 0) { %>
          <p class="text-gray-500 text-sm text-center py-6">No upcoming classes right now.</p>
        <% } %>
      </div>
    </div>
  </main>

  <script src="/js/page-animations.js"></script>
  <script>lucide.createIcons();</script>
</body>
</html>