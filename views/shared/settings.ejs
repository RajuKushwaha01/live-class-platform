<%- include('../partials/shell-top', { active: 'settings', title: 'Account settings' }) %>
<% const initials = ((profile.name || 'U').trim().split(/\s+/).map(w => w[0]).slice(0,2).join('') || 'U').toUpperCase(); %>

<div class="page-head"><div><span class="badge b-accent"><%= role === 'host' ? 'Teacher' : role === 'admin' ? 'Admin' : 'Student' %></span><h2>Account settings</h2><p class="muted">Manage your profile and keep your account secure.</p></div></div>

<% if (message) { %><div class="alert ok"><%= message %></div><% } %>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>

<div class="grid g-main">
  <div class="col">
    <section class="card reveal">
      <div class="card-h"><h3>Profile</h3></div>
      <form action="/account/profile" method="POST">
        <div class="form-grid">
          <div class="field"><label>Full name</label><input class="input" name="name" value="<%= profile.name %>" required /></div>
          <div class="field"><label>Email</label><input class="input" type="email" name="email" value="<%= profile.email %>" required /></div>
        </div>
        <button class="btn btn-primary">Save changes</button>
      </form>
    </section>

    <section class="card reveal">
      <div class="card-h"><h3>Change password</h3></div>
      <form action="/account/password" method="POST">
        <div class="field"><label>Current password</label><input class="input" type="password" name="current" required autocomplete="current-password" /></div>
        <div class="form-grid">
          <div class="field"><label>New password</label><input class="input" type="password" name="next" minlength="6" required autocomplete="new-password" /></div>
          <div class="field"><label>Confirm new password</label><input class="input" type="password" name="confirm" minlength="6" required autocomplete="new-password" /></div>
        </div>
        <button class="btn btn-soft">Update password</button>
      </form>
    </section>
  </div>

  <aside class="col">
    <div class="card center reveal">
      <div class="avatar" style="width:76px;height:76px;border-radius:24px;font-size:26px;margin:0 auto 12px"><%= initials %></div>
      <h3><%= profile.name %></h3>
      <p class="muted small"><%= profile.email %></p>
      <p class="muted small mt-s">Member since <%= new Date(profile.createdAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %></p>
    </div>
    <div class="card reveal">
      <div class="card-h"><h3>Shortcuts</h3></div>
      <div class="col" style="gap:10px">
        <div class="row between"><span class="muted">Search anywhere</span><kbd>Ctrl K</kbd></div>
        <div class="row between"><span class="muted">Quick search</span><kbd>/</kbd></div>
        <div class="row between"><span class="muted">Light / dark</span><span class="muted small">top bar ☀️</span></div>
      </div>
    </div>
  </aside>
</div>
<%- include('../partials/shell-bottom') %>