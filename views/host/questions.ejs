<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Questions</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/theme.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="relative min-h-screen">
  <%- include('../partials/sidebar', { role: 'host', active: 'questions' }) %>
  <main class="ml-64 p-8 relative z-10">
    <div class="fixed top-4 right-6 z-30">
      <%- include('../partials/notification-bell', { userId: user._id }) %>
      <%- include('../partials/live-meeting-alert') %>
    </div>
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-white text-3xl font-bold">❓ Question Sets (Quizzes)</h1>
      <a href="/assignment/create" class="btn-glow text-white text-sm px-5 py-2.5 rounded-lg">+ New Question Set</a>
    </div>
    <p class="text-gray-400 text-sm mb-6">To send a question live during a class, open the meeting room and use the Q&A panel. Question sets here are quizzes and chapter tests you can review or reuse.</p>
    <div class="grid md:grid-cols-2 gap-5">
      <% liveSets.forEach(a => { %>
        <div class="glass-card card-3d p-5">
          <h3 class="text-white font-semibold mb-1"><%= a.title %></h3>
          <p class="text-gray-400 text-sm mb-3"><%= a.questions.length %> questions • <%= a.submissions.length %> responses</p>
          <a href="/assignment/grade/<%= a._id %>" class="text-indigo-300 text-sm hover:text-indigo-200">View Responses →</a>
        </div>
      <% }) %>
      <% if (liveSets.length === 0) { %><p class="text-gray-500 col-span-2 text-center py-10">No quizzes created yet.</p><% } %>
    </div>
  </main>
  <script>lucide.createIcons();</script>
</body>
</html>