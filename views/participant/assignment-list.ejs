<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>My Assignments</title>
    <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body class="bg-gradient-to-br from-slate-900 via-indigo-950 to-purple-950 min-h-screen p-6">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-white text-3xl font-bold mb-6">📋 My Assignments</h2>

    <div class="grid gap-4">
      <% assignments.forEach(a => { %>
        <div class="assignment-card bg-white/10 backdrop-blur-xl border border-white/20 rounded-xl p-5 flex items-center justify-between">
          <div>
            <h3 class="text-white font-semibold text-lg"><%= a.title %></h3>
            <p class="text-gray-400 text-sm capitalize"><%= a.type.replace('_',' ') %> • <%= a.questions.length %> Questions</p>
            <% if (a.dueDate) { %>
              <p class="text-gray-500 text-xs">Due: <%= new Date(a.dueDate).toLocaleString() %></p>
            <% } %>
          </div>
          <% if (a.alreadySubmitted) { %>
            <% const mySub = a.submissions ? a.submissions.find(s => String(s.participant) === String(user._id)) : null; %>
            <% if (mySub && mySub.isGraded) { %>
              <a href="/assignment/take/<%= a._id %>" class="bg-green-500/20 hover:bg-green-500/30 text-green-400 border border-green-500/30 px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2">
                ✅ <%= mySub.totalScore %>/<%= mySub.maxScore %>
              </a>
            <% } else { %>
              <a href="/assignment/take/<%= a._id %>" class="bg-yellow-500/20 hover:bg-yellow-500/30 text-yellow-400 border border-yellow-500/30 px-4 py-2 rounded-lg text-sm transition flex items-center gap-2">
                ⏳ Awaiting Grade
              </a>
            <% } %>
          <% } else { %>
            <a href="/assignment/take/<%= a._id %>" class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white px-4 py-2 rounded-lg text-sm hover:scale-105 transition">Start →</a>
          <% } %>
        </div>
      <% }) %>
      <% if (assignments.length === 0) { %>
        <p class="text-gray-400 text-center py-10">No assignments yet.</p>
      <% } %>
    </div>
  </div>
  <script>
    gsap.from(".assignment-card", { opacity: 0, y: 20, stagger: 0.1, duration: 0.5 });
  </script>
</body>
</html>