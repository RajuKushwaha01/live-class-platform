<header class="fixed top-4 inset-x-0 z-50 px-4">
  <nav class="nav-pill mx-auto max-w-5xl flex items-center justify-between rounded-full pl-4 pr-2 py-2">
    <a href="/" class="flex items-center gap-2 font-display font-bold text-lg text-white">
      <span class="logo-mark">E</span> EduLive
    </a>

    <div class="navbar-links hidden md:flex items-center gap-1">
      <a class="nav-link" href="/#home">Home</a>
      <a class="nav-link" href="/#features">Features</a>
      <a class="nav-link" href="/#how">How it works</a>
      <a class="nav-link" href="/#portals">Portals</a>
    </div>

    <div class="navbar-links hidden md:flex items-center gap-2">
      <% if (typeof currentUser !== "undefined" && currentUser) { %>
        <a href="/<%= currentUser.role %>/dashboard" class="btn-ghost px-4 py-2 text-sm">Dashboard</a>
        <a href="/auth/logout" class="btn-glow px-5 py-2 text-sm">Logout</a>
      <% } else { %>
        <a href="/auth/login?portal=student" class="btn-ghost px-4 py-2 text-sm">Sign in</a>
        <a href="/auth/register?portal=teacher" class="btn-glow px-5 py-2 text-sm">Get started</a>
      <% } %>
    </div>

    <button id="navHamburger" class="navbar-hamburger text-white p-2 mr-1" aria-label="Menu">
      <i data-lucide="menu" id="navMenuIcon" class="w-6 h-6"></i>
    </button>
  </nav>
</header>

<div id="navMobileMenu" class="navbar-mobile-menu" style="top:76px">
  <div class="flex flex-col gap-1">
    <a href="/#home" class="py-3 border-b border-white/10 text-sm text-gray-300">Home</a>
    <a href="/#features" class="py-3 border-b border-white/10 text-sm text-gray-300">Features</a>
    <a href="/#how" class="py-3 border-b border-white/10 text-sm text-gray-300">How it works</a>
    <a href="/#portals" class="py-3 border-b border-white/10 text-sm text-gray-300">Portals</a>
    <% if (typeof currentUser !== "undefined" && currentUser) { %>
      <a href="/<%= currentUser.role %>/dashboard" class="btn-glow mt-3 py-3 text-sm">Dashboard</a>
    <% } else { %>
      <a href="/auth/login?portal=student" class="btn-ghost mt-3 py-3 text-sm">Student sign in</a>
      <a href="/auth/login?portal=teacher" class="btn-glow mt-2 py-3 text-sm">Teacher sign in</a>
    <% } %>
  </div>
</div>

<script>
  (function () {
    const btn = document.getElementById("navHamburger"), menu = document.getElementById("navMobileMenu"), icon = document.getElementById("navMenuIcon");
    let open = false;
    function set(v) { open = v; menu.classList.toggle("open", v); icon.setAttribute("data-lucide", v ? "x" : "menu"); lucide.createIcons(); }
    btn.addEventListener("click", () => set(!open));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
  })();
</script>