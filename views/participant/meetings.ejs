<%- include('../partials/shell-top', { role: 'participant', active: 'meetings', title: 'Classes' }) %>
<div class="page-head"><div><span class="badge b-accent">Classes</span><h2>My classes</h2><p class="muted">Join live sessions or revisit past ones.</p></div></div>

<div class="toolbar">
  <div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#mList" placeholder="Search classes or teachers…" /></div>
  <div class="tabs" data-filter-for="#mList">
    <button class="on" data-f="all">All</button><button data-f="live">Live</button><button data-f="scheduled">Upcoming</button><button data-f="ended">Ended</button>
  </div>
</div>

<div class="grid g-auto" id="mList" data-list>
  <% meetings.forEach(m => {
    const when = m.scheduledDate ? new Date(m.scheduledDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Anytime';
  %>
    <article class="card hover" data-item data-status="<%= m.status %>">
      <div class="row between">
        <span class="ico"><i data-lucide="<%= m.status === 'live' ? 'radio' : 'video' %>"></i></span>
        <% if (m.status === 'live') { %><span class="badge b-red"><span class="live-dot"></span>Live now</span>
        <% } else if (m.status === 'ended') { %><span class="badge">Ended</span>
        <% } else { %><span class="badge b-amber">Upcoming</span><% } %>
      </div>
      <h3 class="mt-s truncate"><%= m.title %></h3>
      <p class="muted small truncate"><%= m.chapterName || 'Class session' %></p>
      <div class="row wrap gap-s mt-s muted small">
        <span><i data-lucide="user" style="width:14px;height:14px"></i> <%= m.host ? m.host.name : '—' %></span>
        <span><i data-lucide="calendar" style="width:14px;height:14px"></i> <%= when %><%= m.startTime ? ' · ' + m.startTime : '' %></span>
        <% if (m.duration) { %><span><i data-lucide="clock" style="width:14px;height:14px"></i> <%= m.duration %> min</span><% } %>
      </div>
      <div class="mt">
        <% if (m.status === 'ended') { %><button class="btn btn-ghost btn-block" disabled>Session ended</button>
        <% } else { %><a class="btn <%= m.status === 'live' ? 'btn-primary' : 'btn-soft' %> btn-block" href="/meeting/<%= m.meetingCode %>"><%= m.status === 'live' ? 'Join now' : 'Open class' %></a><% } %>
      </div>
    </article>
  <% }) %>
</div>
<div class="empty" data-empty-for="#mList" <%= meetings.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="video-off"></i></div>No classes found. Got a code from your teacher? Use the “Join a class” box in the sidebar.</div>
<%- include('../partials/shell-bottom') %>