<%- include('../partials/shell-top', { role: 'host', active: 'meetings', title: 'New meeting' }) %>
<% const created = (typeof createdMeeting !== 'undefined') ? createdMeeting : null; const err = (typeof error !== 'undefined') ? error : null; %>

<% if (created) { %>
  <div class="card center reveal" style="max-width:560px;margin:20px auto;padding:36px 28px">
    <div class="ico" style="margin:0 auto 14px;width:64px;height:64px;color:var(--ok)"><i data-lucide="check-circle-2" style="width:32px;height:32px"></i></div>
    <h2 style="font-size:24px;font-weight:800">Meeting created!</h2>
    <p class="muted mt-s"><%= created.title %></p>
    <div class="item mt" style="justify-content:space-between"><span class="mono" style="font-size:20px;font-weight:800"><%= created.meetingCode %></span><button class="btn btn-soft btn-sm" data-copy="/meeting/<%= created.meetingCode %>"><i data-lucide="copy"></i> Copy link</button></div>
    <p class="muted small mt-s">Share this link with your students<%= created.meetingPassword ? ' along with the meeting password.' : '.' %></p>
    <div class="row wrap mt" style="justify-content:center">
      <a class="btn btn-primary" href="/meeting/room/<%= created.meetingCode %>"><i data-lucide="video"></i> Enter room</a>
      <a class="btn btn-ghost" href="/invite/<%= created.meetingCode %>"><i data-lucide="mail"></i> Invite by email</a>
      <a class="btn btn-ghost" href="/host/meetings">All meetings</a>
    </div>
  </div>
<% } else { %>
  <div class="page-head"><div><span class="badge b-accent">New class</span><h2>Create a meeting</h2><p class="muted">Fill in the details to generate a shareable class link.</p></div></div>
  <% if (err) { %><div class="alert err"><%= err %></div><% } %>

  <form action="/meeting/create" method="POST">
    <div class="grid g-main">
      <div class="card reveal">
        <div class="field"><label>Meeting title</label><input class="input" name="title" placeholder="e.g. Java OOP — Live class" required /></div>
        <div class="field"><label>Chapter / topic</label><input class="input" name="chapterName" placeholder="e.g. Chapter 3 — Inheritance" required /></div>
        <div class="field"><label>Description</label><textarea class="textarea" name="description" placeholder="What will you cover?"></textarea></div>
        <div class="form-grid">
          <div class="field"><label>Date</label><input class="input" type="date" name="scheduledDate" id="dateIn" required /></div>
          <div class="field"><label>Start time</label><input class="input" type="time" name="startTime" id="timeIn" required /></div>
          <div class="field"><label>Duration (minutes)</label><input class="input" type="number" name="duration" min="5" value="60" required /></div>
          <div class="field"><label>Max participants</label><input class="input" type="number" name="maxParticipants" min="2" value="50" /></div>
        </div>
      </div>
      <aside class="col">
        <div class="card sticky reveal">
          <div class="card-h"><h3>Security</h3></div>
          <div class="field"><label>Meeting password (optional)</label><input class="input" type="password" name="meetingPassword" placeholder="Leave blank for open access" autocomplete="new-password" /></div>
          <p class="muted small mb">After creating you can lock the room, enable a waiting room, or make it invite-only.</p>
          <button class="btn btn-primary btn-block"><i data-lucide="link"></i> Create &amp; generate link</button>
        </div>
      </aside>
    </div>
  </form>
  <script>
    var n = new Date(); document.getElementById('dateIn').value = n.toISOString().slice(0, 10);
    document.getElementById('timeIn').value = String(n.getHours()).padStart(2, '0') + ':' + String(n.getMinutes()).padStart(2, '0');
  </script>
<% } %>
<%- include('../partials/shell-bottom') %>