<%- include('../partials/shell-top', { role: 'participant', active: 'materials', title: 'Materials' }) %>
<div class="page-head"><div><span class="badge b-accent">Library</span><h2>Study materials</h2><p class="muted">Notes, PDFs, code and videos shared in your classes.</p></div></div>

<div class="toolbar"><div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#matList" placeholder="Search chapters…" /></div></div>

<div class="grid g-auto" id="matList" data-list>
  <% chapters.forEach(c => { %>
    <article class="card hover" data-item data-status="all">
      <div class="row between"><span class="ico"><i data-lucide="book-open"></i></span><span class="badge"><%= c.meeting ? c.meeting.title : 'Class' %></span></div>
      <h3 class="mt-s"><%= c.title %></h3>
      <% if (c.explanation) { %><p class="muted small mt-s"><%= c.explanation.length > 160 ? c.explanation.slice(0, 160) + '…' : c.explanation %></p><% } %>

      <div class="row wrap gap-s mt">
        <% if (c.pdfFile) { %><a class="btn btn-soft btn-sm" target="_blank" href="<%= c.pdfFile %>"><i data-lucide="file-text"></i> PDF</a><% } %>
        <% if (c.videoUrl) { %><a class="btn btn-soft btn-sm" target="_blank" rel="noopener" href="<%= c.videoUrl %>"><i data-lucide="play-circle"></i> Video</a><% } %>
        <% (c.images || []).forEach((img, i) => { %><a class="btn btn-ghost btn-sm" target="_blank" href="<%= img %>"><i data-lucide="image"></i> Image <%= i + 1 %></a><% }) %>
        <% (c.links || []).forEach(l => { %><a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="<%= l.url %>"><i data-lucide="link"></i> <%= l.title || 'Link' %></a><% }) %>
      </div>

      <% if (c.notes || (c.codeExamples && c.codeExamples.length)) { %>
        <details class="mt">
          <summary class="link" style="cursor:pointer">Notes &amp; code examples</summary>
          <% if (c.notes) { %><p class="muted small mt-s" style="white-space:pre-wrap"><%= c.notes %></p><% } %>
          <% (c.codeExamples || []).forEach(ex => { %>
            <div class="mt-s"><span class="badge b-accent"><%= ex.language || 'code' %></span> <span class="muted small"><%= ex.description || '' %></span>
              <pre class="code mt-s"><%= ex.code %></pre></div>
          <% }) %>
        </details>
      <% } %>
    </article>
  <% }) %>
</div>
<div class="empty" data-empty-for="#matList" <%= chapters.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="folder-open"></i></div>No materials yet. They appear here after you join a class that shares them.</div>
<%- include('../partials/shell-bottom') %>