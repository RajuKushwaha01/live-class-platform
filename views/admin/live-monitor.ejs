<%- include('../partials/shell-top', { role: 'admin', active: 'live', title: 'Live monitor' }) %>
<div class="page-head">
  <div><span class="badge b-red"><span class="live-dot"></span> Real time</span><h2>Live monitor</h2><p class="muted"><%= liveMeetings.length %> class<%= liveMeetings.length === 1 ? '' : 'es' %> in session · refreshes every 20 seconds.</p></div>
  <button class="btn btn-ghost" onclick="location.reload()"><i data-lucide="refresh-cw"></i> Refresh</button>
</div>

<div class="grid g-auto">
  <% liveMeetings.forEach(m => { %>
    <article class="card hover reveal">
      <div class="row between"><span class="ico"><i data-lucide="radio"></i></span><span class="badge b-red"><span class="live-dot"></span> <span data-since="<%= m.startedAt ? new Date(m.startedAt).toISOString() : new Date().toISOString() %>">0:00</span></span></div>
      <h3 class="mt-s truncate"><%= m.title %></h3>
      <p class="muted small truncate"><%= m.chapterName || 'Class session' %></p>
      <div class="row between mt-s item" style="padding:10px 12px">
        <span><i data-lucide="user" style="width:14px;height:14px"></i> <%= m.host ? m.host.name : '—' %></span>
        <span><i data-lucide="users" style="width:14px;height:14px"></i> <%= m.participants.length %></span>
        <span class="mono small"><%= m.meetingCode %></span>
      </div>
      <div class="row gap-s mt">
        <a class="btn btn-primary btn-sm grow" href="/meeting/room/<%= m.meetingCode %>"><i data-lucide="eye"></i> Monitor</a>
        <form action="/admin/meetings/<%= m.meetingCode %>/end" method="POST" data-confirm="End this meeting for everyone?"><button class="btn btn-danger btn-sm"><i data-lucide="power"></i> End</button></form>
      </div>
    </article>
  <% }) %>
</div>
<% if (!liveMeetings.length) { %><div class="card empty"><div class="ico"><i data-lucide="radio"></i></div>No classes are live right now.</div><% } %>
<script>setTimeout(function () { location.reload(); }, 20000);</script>
<%- include('../partials/shell-bottom') %>