<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>Reset Password — EduLive</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
 <!-- NEW -->
<body class="relative min-h-screen flex items-center justify-center px-4 sm:px-6 py-8 form-page-padding">
<div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <div id="card" class="glass-card card-3d p-10 max-w-md w-full relative z-10">
    <div class="text-center mb-8">
      <i data-lucide="lock" class="w-10 h-10 text-indigo-300 mx-auto mb-3"></i>
      <h2 class="text-white text-2xl font-bold">Set New Password</h2>
    </div>

    <% if (error) { %>
      <div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-2 rounded-lg mb-4 text-sm text-center"><%= error %></div>
    <% } %>

    <form action="/auth/reset-password/<%= token %>" method="POST" class="space-y-4">
      <input type="password" name="password" required minlength="6" placeholder="New password (min 6 characters)"
        class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" />

      <button type="submit" class="btn-glow w-full text-white py-3 rounded-xl font-semibold">
        Reset Password
      </button>
    </form>
  </div>

  <script>
    lucide.createIcons();
    gsap.from("#card", { opacity: 0, y: 30, duration: 0.7 });
  </script>
</body>
</html>