<%- include('../partials/shell-top', { role: 'host', active: 'assignments', title: 'Grading' }) %>
<% const subs = assignment.submissions; const pendingN = subs.filter(s => !s.isGraded).length; %>
<a class="link" href="/host/assignments">← Back to assignments</a>
<div class="page-head mt-s">
  <div><span class="badge b-accent"><%= assignment.type.replace('_', ' ') %></span><h2><%= assignment.title %></h2><p class="muted"><%= subs.length %> submission<%= subs.length === 1 ? '' : 's' %> · <%= pendingN %> waiting for marks</p></div>
  <a class="btn btn-ghost" href="/assignment/results/<%= assignment._id %>"><i data-lucide="bar-chart-3"></i> Results</a>
</div>

<div class="toolbar">
  <div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#gList" placeholder="Search student…" /></div>
  <div class="tabs" data-filter-for="#gList"><button class="on" data-f="all">All</button><button data-f="pending">Needs grading</button><button data-f="graded">Graded</button></div>
</div>

<div id="gList" data-list class="col">
  <% subs.forEach(sub => { %>
    <article class="card" data-item data-status="<%= sub.isGraded ? 'graded' : 'pending' %>">
      <div class="row between wrap">
        <div class="row"><span class="avatar"><%= (sub.participantName || '?').slice(0, 1).toUpperCase() %></span>
          <div><b><%= sub.participantName %></b><div class="muted small">Submitted <%= new Date(sub.submittedAt).toLocaleString() %></div></div></div>
        <div class="row gap-s">
          <% if (sub.fileUpload) { %><a class="btn btn-ghost btn-sm" target="_blank" href="<%= sub.fileUpload %>"><i data-lucide="paperclip"></i> File</a><% } %>
          <span class="badge <%= sub.isGraded ? 'b-green' : 'b-amber' %>"><%= sub.isGraded ? 'Graded' : 'Needs grading' %></span>
          <b><%= sub.totalScore %>/<%= sub.maxScore %></b>
        </div>
      </div>

      <form class="gform mt" action="/assignment/grade/<%= assignment._id %>/<%= sub._id %>" method="POST">
        <% sub.answers.forEach(ans => { const q = assignment.questions[ans.questionIndex]; if (!q) return; %>
          <div class="q mb">
            <div class="row between wrap"><b>Q<%= ans.questionIndex + 1 %>. <%= q.questionText %></b><span class="badge"><%= q.type.replace('_', ' ') %> · max <%= q.points %></span></div>
            <% if (q.type === 'coding') { %><pre class="code mt-s"><%= ans.answerText || '(no answer)' %></pre>
            <% } else { %><div class="mt-s">Answer: <b><%= ans.answerText || '(no answer)' %></b></div><% } %>
            <% if (q.correctAnswer && q.type !== 'coding') { %><div class="small mt-s" style="color:var(--ok)">Expected: <b><%= q.correctAnswer %></b></div><% } %>
            <div class="row mt-s wrap">
              <label class="muted small">Marks</label>
              <input type="number" class="input sm pts" style="width:90px" min="0" max="<%= q.points %>" step="0.5" value="<%= ans.pointsAwarded %>" data-qi="<%= ans.questionIndex %>" />
              <button type="button" class="btn btn-soft btn-sm" onclick="var i=this.parentNode.querySelector('.pts');i.value=i.max">Full marks</button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="this.parentNode.querySelector('.pts').value=0">Zero</button>
            </div>
          </div>
        <% }) %>
        <input type="hidden" name="pointsData" class="pointsData" />
        <button class="btn btn-primary"><i data-lucide="check"></i> Save marks &amp; notify student</button>
      </form>
    </article>
  <% }) %>
</div>
<div class="empty" data-empty-for="#gList" <%= subs.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="inbox"></i></div>No submissions yet. They appear here instantly when students submit.</div>

<script>
  document.querySelectorAll('.gform').forEach(function (f) {
    f.addEventListener('submit', function () {
      var pts = Array.prototype.map.call(f.querySelectorAll('.pts'), function (i) { return { questionIndex: Number(i.dataset.qi), pointsAwarded: Number(i.value) || 0 }; });
      f.querySelector('.pointsData').value = JSON.stringify(pts);
    });
  });
</script>
<%- include('../partials/shell-bottom') %>