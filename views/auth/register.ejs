<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>Register — EduLive</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/animations.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<!-- NEW -->
<body class="relative min-h-screen flex items-center justify-center px-4 sm:px-6 py-8 form-page-padding">
<div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div id="registerCard" class="glass-card card-3d p-10 max-w-md w-full relative z-10">
    <div class="text-center mb-8">
      <span class="gradient-text text-2xl font-bold">🎓 EduLive</span>
      <h2 class="text-white text-2xl font-bold mt-4">Create Your Account</h2>
      <p class="text-gray-400 text-sm mt-1">Join as a host or a participant</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-2 rounded-lg mb-4 text-sm text-center">
        <%= error %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST" class="space-y-4">
      <div>
        <label class="text-gray-300 text-xs mb-1 block">Full Name</label>
        <input type="text" name="name" required placeholder="John Doe"
          class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" />
      </div>
      <div>
        <label class="text-gray-300 text-xs mb-1 block">Email</label>
        <input type="email" name="email" required placeholder="you@example.com"
          class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" />
      </div>
      <div>
        <label class="text-gray-300 text-xs mb-1 block">Password</label>
        <input type="password" name="password" required minlength="6" placeholder="Minimum 6 characters"
          class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" />
      </div>

      <div>
        <label class="text-gray-300 text-xs mb-2 block">I am joining as a:</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="role-option">
            <input type="radio" name="role" value="host" class="peer hidden" checked />
            <div class="cursor-pointer bg-white/5 border border-white/20 peer-checked:border-indigo-400 peer-checked:bg-indigo-500/20 rounded-xl px-4 py-3 text-center transition">
              <i data-lucide="graduation-cap" class="w-5 h-5 text-indigo-300 mx-auto mb-1"></i>
              <span class="text-white text-sm">Host / Teacher</span>
            </div>
          </label>
          <label class="role-option">
            <input type="radio" name="role" value="participant" class="peer hidden" />
            <div class="cursor-pointer bg-white/5 border border-white/20 peer-checked:border-indigo-400 peer-checked:bg-indigo-500/20 rounded-xl px-4 py-3 text-center transition">
              <i data-lucide="user" class="w-5 h-5 text-indigo-300 mx-auto mb-1"></i>
              <span class="text-white text-sm">Participant</span>
            </div>
          </label>
        </div>
      </div>

      <button type="submit" class="btn-glow w-full text-white py-3 rounded-xl font-semibold flex items-center justify-center gap-2">
        <i data-lucide="user-plus" class="w-4 h-4"></i> Create Account
      </button>
    </form>

    <p class="text-center text-gray-400 text-sm mt-6">
      Already have an account? <a href="/auth/login" class="text-indigo-300 hover:text-indigo-200 font-medium">Login</a>
    </p>
  </div>

  <script>
    lucide.createIcons();
    gsap.from("#registerCard", { opacity: 0, y: 30, duration: 0.7, ease: "power3.out" });
  </script>
</body>
</html>