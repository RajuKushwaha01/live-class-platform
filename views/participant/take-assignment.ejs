<%- include('../partials/shell-top', { role: 'participant', active: 'assignments', title: 'Task' }) %>
<%
  const total = assignment.questions.length;
  const pct = (mySubmission && mySubmission.maxScore) ? Math.round(mySubmission.totalScore / mySubmission.maxScore * 100) : 0;
  const J = v => JSON.stringify(v).replace(/</g, '\\u003c');
%>
<a class="link" href="/assignment/my-assignments">← Back to tasks</a>
<div class="page-head mt-s">
  <div><span class="badge b-accent"><%= assignment.type.replace('_', ' ') %></span><h2><%= assignment.title %></h2><% if (assignment.description) { %><p class="muted"><%= assignment.description %></p><% } %></div>
  <% if (assignment.dueDate) { %><span class="badge b-amber"><i data-lucide="clock" style="width:14px;height:14px"></i> Due <%= new Date(assignment.dueDate).toLocaleString('en-US', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span><% } %>
</div>

<% if (alreadySubmitted && mySubmission) { %>

  <% if (mySubmission.isGraded) { %>
    <div class="hero on-grad reveal">
      <div class="grow"><span class="hero-tag">Graded ✅</span><h2>You scored <%= mySubmission.totalScore %> / <%= mySubmission.maxScore %></h2>
        <p><%= pct >= 75 ? 'Excellent work!' : pct >= 50 ? 'Good effort — keep going.' : 'Review the answers below and try again next time.' %><% if (mySubmission.gradedAt) { %> Graded <%= new Date(mySubmission.gradedAt).toLocaleDateString() %>.<% } %></p></div>
      <div class="ring-wrap"><svg class="ring" viewBox="0 0 42 42" width="104" height="104"><circle class="ring-bg" cx="21" cy="21" r="16" pathLength="100"/><circle class="ring-fg" cx="21" cy="21" r="16" pathLength="100" stroke-dasharray="<%= pct %> 100"/></svg><b><%= pct %>%</b></div>
    </div>

    <div class="card mt reveal">
      <div class="card-h"><h3>Answer review</h3></div>
      <% mySubmission.answers.forEach(ans => { const q = assignment.questions[ans.questionIndex]; if (!q) return; %>
        <div class="item" style="align-items:flex-start">
          <span class="badge <%= ans.pointsAwarded >= q.points ? 'b-green' : ans.pointsAwarded > 0 ? 'b-amber' : 'b-red' %>"><%= ans.pointsAwarded %>/<%= q.points %></span>
          <div class="grow">
            <b>Q<%= ans.questionIndex + 1 %>. <%= q.questionText %></b>
            <% if (q.type === 'coding') { %><pre class="code mt-s"><%= ans.answerText || '(no answer)' %></pre>
            <% } else { %><div class="muted small mt-s">Your answer: <b style="color:var(--text)"><%= ans.answerText || '(no answer)' %></b></div><% } %>
            <% if (q.correctAnswer && ans.pointsAwarded < q.points && q.type !== 'coding') { %><div class="small mt-s" style="color:var(--ok)">Correct answer: <b><%= q.correctAnswer %></b></div><% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card center reveal" style="padding:40px 20px">
      <div class="ico" style="margin:0 auto 14px;width:60px;height:60px"><i data-lucide="hourglass"></i></div>
      <h3 style="font-size:20px">Submitted — waiting for your teacher</h3>
      <p class="muted mt-s" style="max-width:460px;margin-inline:auto">Some answers need manual marking. You'll get a notification the moment your score is ready.</p>
      <a class="btn btn-soft mt" href="/assignment/my-assignments">Back to tasks</a>
    </div>
  <% } %>

<% } else { %>

  <form id="taskForm" action="/assignment/submit/<%= assignment._id %>" method="POST" enctype="multipart/form-data">
    <div class="grid g-main">
      <div class="col">
        <% assignment.questions.forEach((q, i) => { %>
          <section class="q reveal" id="q<%= i %>">
            <div class="row between"><b>Question <%= i + 1 %></b><span class="badge"><%= q.points %> pt<%= q.points > 1 ? 's' : '' %></span></div>
            <p class="mt-s" style="font-size:15.5px;font-weight:600"><%= q.questionText %></p>
            <% if (q.questionImage) { %><img src="<%= q.questionImage %>" alt="" style="max-height:220px;border-radius:12px;margin-top:10px" /><% } %>

            <% if (q.type === 'mcq') { q.options.forEach((opt, oi) => { %>
              <label class="opt"><input type="radio" name="q<%= i %>" value="<%= opt %>" class="answer-input" data-index="<%= i %>" />
                <% if (q.optionImages && q.optionImages[oi]) { %><img src="<%= q.optionImages[oi] %>" alt="" style="width:46px;height:46px;object-fit:cover;border-radius:8px" /><% } %>
                <span><b class="muted" style="margin-right:6px"><%= 'ABCD'[oi] %>.</b><%= opt %></span></label>
            <% }) } else if (q.type === 'true_false') { %>
              <label class="opt"><input type="radio" name="q<%= i %>" value="True" class="answer-input" data-index="<%= i %>" /> <span>True</span></label>
              <label class="opt"><input type="radio" name="q<%= i %>" value="False" class="answer-input" data-index="<%= i %>" /> <span>False</span></label>
            <% } else if (q.type === 'coding') { %>
              <div class="muted small mt-s">Language: <b><%= q.codeLanguage || 'Any' %></b> · write your code below</div>
              <textarea class="code-area answer-input mt-s" data-index="<%= i %>" spellcheck="false"><%= q.starterCode || '' %></textarea>
            <% } else { %>
              <input class="input answer-input mt-s" data-index="<%= i %>" placeholder="Type your answer" />
            <% } %>
          </section>
        <% }) %>
      </div>

      <aside class="col">
        <div class="card sticky">
          <div class="card-h"><h3>Progress</h3><b id="ansCount">0/<%= total %></b></div>
          <div class="progress"><i id="ansBar" style="width:0%"></i></div>
          <div class="qchips mt">
            <% for (let i = 0; i < total; i++) { %><a href="#q<%= i %>" data-chip="<%= i %>"><%= i + 1 %></a><% } %>
          </div>
          <div class="field mt"><label>Attach a file (optional)</label><input type="file" name="fileUpload" class="input" /></div>
          <input type="hidden" name="answers" id="answersInput" />
          <button class="btn btn-primary btn-block" type="submit"><i data-lucide="send"></i> Submit task</button>
          <p class="muted small mt-s center">Your answers are saved on this device as you type.</p>
        </div>
      </aside>
    </div>
  </form>

  <script>
  (function () {
    var form = document.getElementById('taskForm'), total = <%= total %>, KEY = 'draft:<%= assignment._id %>';
    var inputs = Array.prototype.slice.call(document.querySelectorAll('.answer-input'));

    function collect() {
      var map = {};
      inputs.forEach(function (el) {
        var i = Number(el.dataset.index);
        if (el.type === 'radio') { if (el.checked) map[i] = el.value; }
        else map[i] = el.value;
      });
      return map;
    }
    function answered(i) {
      var group = inputs.filter(function (el) { return Number(el.dataset.index) === i; });
      return group.some(function (el) {
        if (el.type === 'radio') return el.checked;
        return el.value.trim() !== '' && el.value !== el.defaultValue;
      });
    }
    function refresh() {
      var n = 0;
      for (var i = 0; i < total; i++) {
        var ok = answered(i); if (ok) n++;
        var chip = document.querySelector('[data-chip="' + i + '"]'); if (chip) chip.classList.toggle('done', ok);
      }
      document.getElementById('ansCount').textContent = n + '/' + total;
      document.getElementById('ansBar').style.width = (total ? Math.round(n / total * 100) : 0) + '%';
      try { localStorage.setItem(KEY, JSON.stringify(collect())); } catch (e) {}
      return n;
    }
    // restore draft
    try {
      var saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved) inputs.forEach(function (el) {
        var i = Number(el.dataset.index); if (saved[i] === undefined) return;
        if (el.type === 'radio') el.checked = (el.value === saved[i]); else el.value = saved[i];
      });
    } catch (e) {}
    inputs.forEach(function (el) { el.addEventListener('input', refresh); el.addEventListener('change', refresh); });
    refresh();

    form.addEventListener('submit', function (e) {
      var n = refresh();
      if (n < total && !confirm('You answered ' + n + ' of ' + total + ' questions. Submit anyway?')) { e.preventDefault(); return; }
      var map = collect(), arr = [];
      for (var i = 0; i < total; i++) arr.push({ questionIndex: i, answerText: map[i] !== undefined ? map[i] : '' });
      document.getElementById('answersInput').value = JSON.stringify(arr);
      try { localStorage.removeItem(KEY); } catch (x) {}
    });
  })();
  </script>
<% } %>
<%- include('../partials/shell-bottom') %>