<%- include('../partials/shell-top', { role: 'host', active: 'meetings', title: 'Meetings' }) %>
<div class="page-head">
  <div><span class="badge b-accent">Classes</span><h2>My meetings</h2><p class="muted">Create, share, invite and manage every class.</p></div>
  <a class="btn btn-primary" href="/meeting/create"><i data-lucide="plus"></i> New meeting</a>
</div>

<div class="toolbar">
  <div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#hmList" placeholder="Search by title, chapter or code…" /></div>
  <div class="tabs" data-filter-for="#hmList"><button class="on" data-f="all">All</button><button data-f="live">Live</button><button data-f="scheduled">Scheduled</button><button data-f="ended">Ended</button></div>
</div>

<div class="grid g-auto" id="hmList" data-list>
  <% meetings.forEach(m => { const when = m.scheduledDate ? new Date(m.scheduledDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) : 'Anytime'; %>
    <article class="card hover" data-item data-status="<%= m.status %>">
      <div class="row between">
        <span class="ico"><i data-lucide="<%= m.status === 'live' ? 'radio' : 'video' %>"></i></span>
        <% if (m.status === 'live') { %><span class="badge b-red"><span class="live-dot"></span>Live</span><% } else if (m.status === 'ended') { %><span class="badge">Ended</span><% } else { %><span class="badge b-amber">Scheduled</span><% } %>
      </div>
      <h3 class="mt-s truncate"><%= m.title %></h3>
      <p class="muted small truncate"><%= m.chapterName || 'No chapter' %> · <%= when %><%= m.startTime ? ' · ' + m.startTime : '' %></p>
      <div class="row between mt-s item" style="padding:8px 10px">
        <span class="mono"><%= m.meetingCode %></span>
        <button class="btn btn-soft btn-sm" data-copy="/meeting/<%= m.meetingCode %>"><i data-lucide="copy"></i> Copy link</button>
      </div>
      <p class="muted small mt-s"><i data-lucide="users" style="width:14px;height:14px"></i> <%= m.participants.length %> joined<%= m.meetingPassword ? ' · 🔒 password' : '' %></p>
      <div class="row wrap gap-s mt">
        <% if (m.status !== 'ended') { %><a class="btn btn-primary btn-sm" href="/meeting/room/<%= m.meetingCode %>">Enter</a><a class="btn btn-ghost btn-sm" href="/invite/<%= m.meetingCode %>">Invite</a><a class="btn btn-ghost btn-sm" href="/chapter/create/<%= m.meetingCode %>">Material</a><% } %>
        <form action="/meeting/<%= m.meetingCode %>/delete" method="POST" data-confirm="Delete this meeting and its materials?"><button class="btn btn-danger btn-sm"><i data-lucide="trash-2"></i></button></form>
      </div>
    </article>
  <% }) %>
</div>
<div class="empty" data-empty-for="#hmList" <%= meetings.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="video-off"></i></div>No meetings found.</div>
<%- include('../partials/shell-bottom') %>