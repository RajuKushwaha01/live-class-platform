<%- include('../partials/shell-top', { role: 'host', active: 'materials', title: 'Materials' }) %>
<div class="page-head"><div><span class="badge b-accent">Library</span><h2>Chapter materials</h2><p class="muted">Everything you've published to your classes.</p></div></div>

<div class="card mb reveal">
  <div class="card-h"><h3>Add new material</h3></div>
  <% if (meetings.length) { %>
    <form class="row wrap" onsubmit="event.preventDefault();var c=this.m.value;if(c)location.href='/chapter/create/'+encodeURIComponent(c);">
      <select class="select" name="m" style="max-width:360px">
        <% meetings.forEach(m => { %><option value="<%= m.meetingCode %>"><%= m.title %> (<%= m.meetingCode %>)</option><% }) %>
      </select>
      <button class="btn btn-primary"><i data-lucide="upload"></i> Add chapter</button>
    </form>
  <% } else { %><p class="muted">Create a meeting first, then attach chapters to it. <a class="link" href="/meeting/create">New meeting →</a></p><% } %>
</div>

<div class="toolbar"><div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#hmat" placeholder="Search chapters…" /></div></div>
<div class="grid g-auto" id="hmat" data-list>
  <% chapters.forEach(c => { %>
    <article class="card hover" data-item data-status="all">
      <div class="row between"><span class="ico"><i data-lucide="book-open"></i></span><span class="badge"><%= c.meeting ? c.meeting.title : 'Class' %></span></div>
      <h3 class="mt-s"><%= c.title %></h3>
      <% if (c.explanation) { %><p class="muted small mt-s"><%= c.explanation.length > 140 ? c.explanation.slice(0, 140) + '…' : c.explanation %></p><% } %>
      <div class="row wrap gap-s mt">
        <% if (c.pdfFile) { %><a class="btn btn-soft btn-sm" target="_blank" href="<%= c.pdfFile %>"><i data-lucide="file-text"></i> PDF</a><% } %>
        <% if (c.videoUrl) { %><a class="btn btn-soft btn-sm" target="_blank" rel="noopener" href="<%= c.videoUrl %>"><i data-lucide="play-circle"></i> Video</a><% } %>
        <% if (c.images && c.images.length) { %><span class="badge"><i data-lucide="image" style="width:13px;height:13px"></i> <%= c.images.length %></span><% } %>
        <% if (c.codeExamples && c.codeExamples.length) { %><span class="badge"><i data-lucide="code-2" style="width:13px;height:13px"></i> <%= c.codeExamples.length %></span><% } %>
      </div>
    </article>
  <% }) %>
</div>
<div class="empty" data-empty-for="#hmat" <%= chapters.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="folder-open"></i></div>No materials published yet.</div>
<%- include('../partials/shell-bottom') %>