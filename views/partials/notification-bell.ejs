<script src="/socket.io/socket.io.js"></script>
<script>
  (function () {
    const uid = "<%= typeof userId !== 'undefined' ? userId : '' %>";
    if (!window.globalSocket) {
      window.globalSocket = io({ transports: ["websocket", "polling"], reconnectionDelay: 2000 });
      window.globalSocket.on("connect", () => {
        if (uid) window.globalSocket.emit("register-user", { userId: uid });
      });
    }
    window.globalSocket.on("new-submission", (data) => {
      const toast = document.createElement("div");
      toast.className = "fixed bottom-6 right-6 glass-card px-4 py-3 text-sm text-white z-50";
      toast.textContent = `📥 ${data.participantName} submitted "${data.assignmentTitle}"`;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 6000);
    });
  })();
</script>

<div id="notifWrapper" class="relative">
  <button id="notifBtn" class="relative text-white p-2 hover:bg-white/10 rounded-full transition">
    <i data-lucide="bell" class="w-5 h-5"></i>
    <span id="notifCount" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center"></span>
  </button>

  <div id="notifDropdown" class="hidden absolute right-0 sm:right-0 -right-12 mt-2 w-72 sm:w-80 glass-card p-3 z-50 max-h-96 overflow-y-auto">
    <div class="flex items-center justify-between mb-2">
      <h4 class="text-white text-sm font-semibold">Notifications</h4>
      <button id="markAllRead" class="text-indigo-300 text-xs hover:text-indigo-200">Mark all read</button>
    </div>
    <div id="notifList" class="space-y-2"></div>
  </div>
</div>

<script>
  const notifBtn = document.getElementById("notifBtn");
  const notifDropdown = document.getElementById("notifDropdown");
  const notifCount = document.getElementById("notifCount");
  const notifList = document.getElementById("notifList");

  notifBtn.addEventListener("click", () => {
    notifDropdown.classList.toggle("hidden");
    loadNotifications();
  });

  document.addEventListener("click", (e) => {
    if (!notifBtn.contains(e.target) && !notifDropdown.contains(e.target)) {
      notifDropdown.classList.add("hidden");
    }
  });

  async function loadNotifications() {
    const res = await fetch("/notification/api/list");
    const data = await res.json();
    updateBadge(data.unreadCount);

    notifList.innerHTML = data.notifications.length
      ? data.notifications.map(n => `
        <a href="${n.link || '#'}" onclick="markRead('${n._id}')"
           class="block bg-white/5 hover:bg-white/10 rounded-lg p-3 text-sm transition ${n.isRead ? 'opacity-60' : ''}">
          <p class="text-white font-medium">${n.title}</p>
          <p class="text-gray-400 text-xs mt-1">${n.message}</p>
        </a>
      `).join("")
      : `<p class="text-gray-500 text-xs text-center py-6">No notifications yet.</p>`;
  }

  function updateBadge(count) {
    if (count > 0) {
      notifCount.textContent = count > 9 ? "9+" : count;
      notifCount.classList.remove("hidden");
    } else {
      notifCount.classList.add("hidden");
    }
  }

  async function markRead(id) {
    await fetch(`/notification/${id}/read`, { method: "POST" });
  }

  document.getElementById("markAllRead").addEventListener("click", async (e) => {
    e.stopPropagation();
    await fetch("/notification/read-all", { method: "POST" });
    loadNotifications();
  });

  // Initial badge load on every page
  loadNotifications();

  // 🔔 Real-time notification updates
  window.globalSocket.on("new-notification", () => {
    loadNotifications();
  });
</script>