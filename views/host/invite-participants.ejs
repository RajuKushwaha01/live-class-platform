<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Invite Participants</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body class="relative min-h-screen">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <main class="max-w-2xl mx-auto pt-16 px-6 relative z-10">
    <div id="card" class="glass-card p-8">
      <h2 class="text-white text-2xl font-bold mb-1">📧 Invite Participants</h2>
      <p class="text-gray-400 mb-6"><%= meeting.title %> — <span class="text-indigo-300"><%= meeting.meetingCode %></span></p>

      <% if (message) { %>
        <div class="bg-green-500/20 border border-green-500 text-green-300 px-4 py-2 rounded-lg mb-4"><%= message %></div>
      <% } %>

      <form action="/invite/<%= meeting.meetingCode %>/send" method="POST" class="space-y-4">
        <textarea name="emails" rows="3" placeholder="Enter emails separated by commas (e.g. a@mail.com, b@mail.com)" required
          class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-3"></textarea>

        <label class="flex items-center gap-2 text-gray-300 text-sm">
          <input type="checkbox" name="inviteOnly" <%= meeting.inviteOnly ? 'checked' : '' %> class="accent-indigo-500" />
          Make this meeting invite-only (only invited emails can join)
        </label>

        <button type="submit" class="btn-glow w-full text-white py-3 rounded-xl font-semibold">Send Invitations</button>
      </form>

      <div class="mt-8">
        <h3 class="text-white font-semibold mb-3">Sent Invitations</h3>
        <div class="space-y-2">
          <% invitations.forEach(inv => { %>
            <div class="flex items-center justify-between bg-white/5 rounded-lg px-4 py-2 text-sm">
              <span class="text-gray-300"><%= inv.email %></span>
              <span class="text-xs px-2 py-1 rounded-full <%= inv.status === 'accepted' ? 'bg-green-500/20 text-green-400' : 'bg-yellow-500/20 text-yellow-400' %>">
                <%= inv.status %>
              </span>
            </div>
          <% }) %>
          <% if (invitations.length === 0) { %>
            <p class="text-gray-500 text-sm">No invitations sent yet.</p>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <script>
    lucide.createIcons();
    gsap.from("#card", { opacity: 0, y: 30, duration: 0.7 });
  </script>
</body>
</html>