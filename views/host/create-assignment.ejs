<%- include('../partials/shell-top', { role: 'host', active: 'assignments', title: 'New assignment' }) %>
<%
  const err = (typeof error !== 'undefined') ? error : null;
  const mts = (typeof meetings !== 'undefined') ? meetings : [];
  const sel = (typeof selectedId !== 'undefined') ? selectedId : '';
%>
<div class="page-head"><div><span class="badge b-accent">Assess</span><h2>Create assignment</h2><p class="muted">MCQ (4 options), True/False, short answer and coding — students are notified instantly.</p></div></div>
<% if (err) { %><div class="alert err"><%= err %></div><% } %>

<form id="aForm" action="/assignment/create" method="POST" enctype="multipart/form-data">
  <div class="grid g-main">
    <div class="col">
      <div class="card reveal">
        <div class="field"><label>Title</label><input class="input" name="title" placeholder="e.g. Chapter 3 quiz" required /></div>
        <div class="field"><label>Instructions</label><textarea class="textarea" name="description" placeholder="Tell students what to do"></textarea></div>
      </div>
      <div id="qWrap" class="col"></div>
      <button type="button" class="btn btn-soft" id="addQ"><i data-lucide="plus"></i> Add question</button>
    </div>

    <aside class="col">
      <div class="card sticky reveal">
        <div class="card-h"><h3>Settings</h3></div>
        <div class="field"><label>Type</label>
          <select class="select" name="type"><option value="quiz">Quiz</option><option value="homework">Homework</option><option value="assignment">Assignment</option><option value="chapter_test">Chapter test</option><option value="coding_challenge">Coding challenge</option></select></div>
        <div class="field"><label>Send to</label>
          <select class="select" name="meetingId"><option value="">All my students</option>
            <% mts.forEach(m => { %><option value="<%= m._id %>" <%= String(m._id) === sel ? 'selected' : '' %>><%= m.title %> (<%= m.meetingCode %>)</option><% }) %></select></div>
        <div class="field"><label>Due date (optional)</label><input class="input" type="datetime-local" name="dueDate" /></div>
        <div class="item" style="justify-content:space-between"><span class="muted">Questions</span><b id="sumQ">0</b></div>
        <div class="item" style="justify-content:space-between"><span class="muted">Total marks</span><b id="sumP">0</b></div>
        <input type="hidden" name="questionsData" id="questionsData" />
        <button class="btn btn-primary btn-block mt"><i data-lucide="send"></i> Publish assignment</button>
      </div>
    </aside>
  </div>
</form>

<script>
(function () {
  var wrap = document.getElementById('qWrap'), uid = 0;

  function fieldsFor(row, type) {
    var id = row.dataset.id, h = '';
    if (type === 'mcq') {
      h = '<label class="muted small">Four options — tick the correct one</label>';
      for (var o = 0; o < 4; o++) {
        h += '<div class="row mt-s"><input type="radio" name="c' + id + '" class="q-correct" value="' + o + '" style="accent-color:var(--a1);width:18px;height:18px" />' +
             '<input class="input sm q-opt" placeholder="Option ' + 'ABCD'[o] + '" />' +
             '<input type="file" accept="image/*" class="input sm opt-img" data-o="' + o + '" style="max-width:150px" title="Optional option image" /></div>';
      }
    } else if (type === 'true_false') {
      h = '<label class="muted small">Correct answer</label><div class="row mt-s">' +
          '<label class="opt" style="margin:0"><input type="radio" name="c' + id + '" class="q-tf" value="True" /> True</label>' +
          '<label class="opt" style="margin:0"><input type="radio" name="c' + id + '" class="q-tf" value="False" /> False</label></div>';
    } else if (type === 'short_answer') {
      h = '<div class="field mt-s"><label>Expected answer (optional — blank means you grade manually)</label><input class="input q-short" /></div>';
    } else {
      h = '<div class="form-grid mt-s"><div class="field"><label>Language</label><input class="input q-lang" placeholder="Java, Python…" /></div></div>' +
          '<div class="field"><label>Starter code (shown to students)</label><textarea class="code-area q-starter" style="min-height:120px" spellcheck="false" placeholder="// starter code"></textarea></div>' +
          '<p class="muted small">Coding answers are graded manually by you.</p>';
    }
    row.querySelector('.tf').innerHTML = h;
  }

  function renumber() {
    var rows = wrap.querySelectorAll('.q'), pts = 0;
    rows.forEach(function (row, idx) {
      row.querySelector('.qn').textContent = 'Question ' + (idx + 1);
      row.querySelector('.q-img').name = 'q' + idx + '_image';
      row.querySelectorAll('.opt-img').forEach(function (f) { f.name = 'q' + idx + '_option' + f.dataset.o + '_image'; });
      pts += Number(row.querySelector('.q-points').value) || 0;
    });
    document.getElementById('sumQ').textContent = rows.length;
    document.getElementById('sumP').textContent = pts;
  }

  function addQ() {
    var id = uid++, row = document.createElement('section');
    row.className = 'q'; row.dataset.id = id;
    row.innerHTML =
      '<div class="row between"><b class="qn"></b><button type="button" class="btn btn-danger btn-sm rm">Remove</button></div>' +
      '<div class="field mt-s"><label>Question</label><input class="input q-text" placeholder="Type your question" /></div>' +
      '<div class="form-grid"><div class="field"><label>Type</label><select class="select q-type"><option value="mcq">Multiple choice (4 options)</option><option value="true_false">True / False</option><option value="short_answer">Short answer</option><option value="coding">Coding</option></select></div>' +
      '<div class="field"><label>Marks</label><input type="number" min="1" value="1" class="input q-points" /></div></div>' +
      '<div class="field"><label>Question image (optional)</label><input type="file" accept="image/*" class="input q-img" /></div>' +
      '<div class="tf"></div>';
    wrap.appendChild(row);
    fieldsFor(row, 'mcq');
    row.querySelector('.q-type').addEventListener('change', function (e) { fieldsFor(row, e.target.value); renumber(); });
    renumber();
    if (window.lucide) lucide.createIcons();
  }

  document.getElementById('addQ').addEventListener('click', addQ);
  wrap.addEventListener('click', function (e) { if (e.target.closest('.rm')) { e.target.closest('.q').remove(); renumber(); } });
  wrap.addEventListener('input', function (e) { if (e.target.classList.contains('q-points')) renumber(); });
  addQ();

  document.getElementById('aForm').addEventListener('submit', function (e) {
    renumber();
    var rows = wrap.querySelectorAll('.q'), out = [];
    if (!rows.length) { e.preventDefault(); toast('Add at least one question', 'error'); return; }
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i], type = r.querySelector('.q-type').value, text = r.querySelector('.q-text').value.trim();
      var q = { questionText: text, type: type, points: Number(r.querySelector('.q-points').value) || 1 };
      if (!text) { e.preventDefault(); toast('Question ' + (i + 1) + ' needs text', 'error'); return; }
      if (type === 'mcq') {
        var opts = Array.prototype.map.call(r.querySelectorAll('.q-opt'), function (o) { return o.value.trim(); });
        var c = r.querySelector('.q-correct:checked');
        if (opts.some(function (o) { return !o; })) { e.preventDefault(); toast('Question ' + (i + 1) + ': fill all 4 options', 'error'); return; }
        if (!c) { e.preventDefault(); toast('Question ' + (i + 1) + ': choose the correct option', 'error'); return; }
        q.options = opts; q.correctAnswer = opts[Number(c.value)];
      } else if (type === 'true_false') {
        var t = r.querySelector('.q-tf:checked');
        if (!t) { e.preventDefault(); toast('Question ' + (i + 1) + ': choose True or False', 'error'); return; }
        q.options = ['True', 'False']; q.correctAnswer = t.value;
      } else if (type === 'short_answer') {
        q.correctAnswer = r.querySelector('.q-short').value.trim();
      } else {
        q.codeLanguage = r.querySelector('.q-lang').value.trim(); q.starterCode = r.querySelector('.q-starter').value;
      }
      out.push(q);
    }
    document.getElementById('questionsData').value = JSON.stringify(out);
  });
})();
</script>
<%- include('../partials/shell-bottom') %>