<%- include('../partials/shell-top', { role: 'host', active: 'assignments', title: 'Assignments' }) %>
<div class="page-head">
  <div><span class="badge b-accent">Assess</span><h2>Assignments</h2><p class="muted">Homework, quizzes, tests and coding challenges.</p></div>
  <a class="btn btn-primary" href="/assignment/create"><i data-lucide="plus"></i> New assignment</a>
</div>
<div class="toolbar"><div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#asList" placeholder="Search assignments…" /></div></div>

<div class="card">
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th>Title</th><th>Type</th><th>Questions</th><th>Submissions</th><th>To grade</th><th></th></tr></thead>
    <tbody id="asList" data-list>
      <% assignments.forEach(a => { const pend = a.submissions.filter(s => !s.isGraded).length; %>
        <tr data-item data-status="all">
          <td><b><%= a.title %></b><div class="muted small"><%= a.dueDate ? 'Due ' + new Date(a.dueDate).toLocaleDateString() : 'No due date' %></div></td>
          <td><span class="badge b-accent"><%= a.type.replace('_', ' ') %></span></td>
          <td><%= a.questions.length %></td><td><%= a.submissions.length %></td>
          <td><% if (pend) { %><span class="badge b-amber"><%= pend %> pending</span><% } else { %><span class="badge b-green">Done</span><% } %></td>
          <td class="right"><div class="row gap-s" style="justify-content:flex-end"><a class="btn btn-primary btn-sm" href="/assignment/grade/<%= a._id %>">Grade</a><a class="btn btn-ghost btn-sm" href="/assignment/results/<%= a._id %>">Results</a></div></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <div class="empty" data-empty-for="#asList" <%= assignments.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="clipboard-list"></i></div>No assignments yet.</div>
</div>
<%- include('../partials/shell-bottom') %>