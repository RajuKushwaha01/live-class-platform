<!DOCTYPE html>
<html lang="en" class="js" data-role="<%= user.role %>">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Join <%= meeting.title %> · EduLive</title>
  <script>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'dark'}catch(e){document.documentElement.dataset.theme='dark'}</script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
  <script src="https://unpkg.com/lucide@0.453.0/dist/umd/lucide.min.js"></script>
</head>
<body>
  <div class="center-screen">
    <div class="card" style="max-width:880px;width:100%;padding:0;overflow:hidden">
      <div class="grid g2" style="gap:0">
        <div style="padding:30px">
          <div class="row"><span class="logo">E</span><b style="font-size:17px">EduLive</b></div>
          <div class="mt">
            <% if (meeting.status === 'live') { %><span class="badge b-red"><span class="live-dot"></span> Live now</span><% } else { %><span class="badge b-amber">Not started yet</span><% } %>
            <h2 style="font-size:26px;font-weight:800;margin:12px 0 4px"><%= meeting.title %></h2>
            <p class="muted"><%= meeting.chapterName || 'Live class' %></p>
            <% if (meeting.description) { %><p class="muted small mt-s"><%= meeting.description %></p><% } %>
          </div>
          <div class="item mt"><span class="avatar"><%= (meeting.host.name || 'T').slice(0, 1).toUpperCase() %></span><div class="grow"><b><%= meeting.host.name %></b><div class="muted small">Teacher</div></div></div>
          <p class="muted small mt-s">Joining as <b style="color:var(--text)"><%= user.name %></b></p>

          <% if (typeof error !== 'undefined' && error) { %><div class="alert err mt"><%= error %></div><% } %>

          <form id="joinForm" action="/meeting/<%= meeting.meetingCode %>/join" method="POST" class="mt">
            <% if (meeting.meetingPassword) { %>
              <div class="field"><label>Meeting password</label><input class="input" type="password" name="password" required autocomplete="off" /></div>
            <% } %>
            <button class="btn btn-primary btn-block"><i data-lucide="log-in"></i> Join class</button>
          </form>
          <p class="center mt-s"><a class="link" href="/<%= user.role === 'host' ? 'host' : 'participant' %>/dashboard">← Back to dashboard</a></p>
        </div>

        <div style="padding:30px;background:var(--surface2);display:flex;flex-direction:column;gap:12px;align-items:center;justify-content:center">
          <div style="width:100%;aspect-ratio:16/10;border-radius:18px;overflow:hidden;background:#05070f;position:relative">
            <video id="pv" autoplay muted playsinline style="width:100%;height:100%;object-fit:cover;transform:scaleX(-1)"></video>
            <div id="pvEmpty" style="position:absolute;inset:0;display:grid;place-items:center;color:var(--muted);text-align:center;padding:12px"><div><i data-lucide="video-off" style="width:30px;height:30px"></i><p class="small mt-s">Camera preview is off</p></div></div>
          </div>
          <button type="button" class="btn btn-soft" id="pvBtn"><i data-lucide="camera"></i> Test camera &amp; mic</button>
          <p class="muted small center" id="pvMsg">Check how you look and sound before joining.</p>
        </div>
      </div>
    </div>
  </div>
  <script>
    lucide.createIcons();
    var stream = null;
    document.getElementById('pvBtn').onclick = function () {
      navigator.mediaDevices.getUserMedia({ video: true, audio: true }).then(function (s) {
        stream = s; document.getElementById('pv').srcObject = s;
        document.getElementById('pvEmpty').style.display = 'none';
        document.getElementById('pvMsg').textContent = 'Looks good! Camera and mic are working ✔';
      }).catch(function () {
        document.getElementById('pvMsg').textContent = window.isSecureContext ? 'Camera/mic blocked. Allow access from the padlock icon.' : 'Open the https:// link to use camera and mic.';
      });
    };
    document.getElementById('joinForm').addEventListener('submit', function () { if (stream) stream.getTracks().forEach(function (t) { t.stop(); }); });
  </script>
</body>
</html>