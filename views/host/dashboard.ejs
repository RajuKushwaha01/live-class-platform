<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Host Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/animations.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body class="relative min-h-screen">

  <!-- TOP NOTIFICATION BELL -->
  <div class="fixed top-4 right-6 z-30">
  <!-- ✅ FIXED -->
<%- include('../partials/notification-bell', { userId: user._id }) %>
<%- include('../partials/live-meeting-alert') %>
</div>

  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <%- include('../partials/sidebar', { role: 'host', active: 'dashboard' }) %>

  <main class="main-content ml-64 p-4 md:p-8 relative z-10 page-fade-in">
    <h1 class="text-white text-3xl font-bold mb-1">Welcome back, <%= user.name %> 👋</h1>
    <p class="text-gray-400 mb-8">Here's what's happening with your classes today.</p>

    <!-- STAT CARDS -->
    <div class="stats-grid grid grid-cols-2 md:grid-cols-4 gap-5 mb-10">
      <div class="stat-card glass-card card-3d p-5">
        <i data-lucide="video" class="text-indigo-300 mb-2"></i>
        <p class="text-3xl font-bold text-white count-up" data-target="<%= meetings.length %>">0</p>
        <p class="text-gray-400 text-sm">Total Meetings</p>
      </div>
      <div class="stat-card glass-card card-3d p-5">
        <i data-lucide="users" class="text-purple-300 mb-2"></i>
        <p class="text-3xl font-bold text-white count-up" data-target="156">0</p>
        <p class="text-gray-400 text-sm">Total Students</p>
      </div>
      <div class="stat-card glass-card card-3d p-5">
        <i data-lucide="clipboard-check" class="text-pink-300 mb-2"></i>
        <p class="text-3xl font-bold text-white count-up" data-target="24">0</p>
        <p class="text-gray-400 text-sm">Assignments</p>
      </div>
      <div class="stat-card glass-card card-3d p-5">
        <i data-lucide="trending-up" class="text-green-300 mb-2"></i>
        <p class="text-3xl font-bold text-white count-up" data-target="87">0</p>
        <p class="text-gray-400 text-sm">Avg. Score %</p>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <!-- UPCOMING MEETINGS -->
      <div class="md:col-span-2 glass-card p-6">
        <h3 class="text-white font-semibold text-lg mb-4">📅 Upcoming Meetings</h3>
        <div class="space-y-3">
          <% meetings.slice(0,5).forEach(m => { %>
            <div class="flex items-center justify-between bg-white/5 rounded-xl p-4 hover:bg-white/10 transition">
              <div>
                <p class="text-white font-medium"><%= m.title %></p>
                <p class="text-gray-400 text-xs"><%= m.chapterName || '' %> • <%= m.status %></p>
              </div>
              <a href="/meeting/room/<%= m.meetingCode %>" class="btn-glow text-white text-xs px-4 py-2 rounded-lg">Enter →</a>
            </div>
          <% }) %>
          <% if (meetings.length === 0) { %>
            <p class="text-gray-500 text-sm text-center py-6">No meetings yet. Create one!</p>
          <% } %>
        </div>
        <a href="/meeting/create" class="btn-glow inline-block mt-4 text-white text-sm px-5 py-2.5 rounded-lg">+ Create New Meeting</a>
      </div>

      <!-- MINI CHART -->
      <div class="glass-card p-6">
        <h3 class="text-white font-semibold text-lg mb-4">📊 Weekly Activity</h3>
        <canvas id="activityChart"></canvas>
      </div>
    </div>
  </main>

  <script src="/js/page-animations.js"></script>
  <script>
    lucide.createIcons();

    new Chart(document.getElementById("activityChart"), {
      type: "line",
      data: {
        labels: ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"],
        datasets: [{
          label: "Students Active",
          data: [12, 19, 14, 25, 22, 30, 18],
          borderColor: "#818cf8",
          backgroundColor: "rgba(129,140,248,0.15)",
          fill: true,
          tension: 0.4,
        }],
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          y: { ticks: { color: "#94a3b8" }, grid: { color: "rgba(255,255,255,0.05)" } },
          x: { ticks: { color: "#94a3b8" }, grid: { display: false } },
        },
      },
    });
  </script>
</body>
</html>