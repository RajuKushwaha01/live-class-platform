<!DOCTYPE html>
<html lang="en" data-role="participant" class="js">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Oops · EduLive</title>
  <script>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'dark'}catch(e){document.documentElement.dataset.theme='dark'}</script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <div class="center-screen">
    <div class="card center" style="max-width:440px;width:100%;padding:36px 28px">
      <div class="ico" style="margin:0 auto 14px;width:60px;height:60px;font-size:28px">⚠️</div>
      <h2 style="font-size:22px;font-weight:800;margin-bottom:8px">Something went wrong</h2>
      <p class="muted" style="margin-bottom:22px"><%= typeof message !== 'undefined' ? message : 'Please try again.' %></p>
      <a class="btn btn-primary" href="/">Go to home</a>
    </div>
  </div>
</body>
</html>