<%- include('../partials/shell-top', { role: 'participant', active: 'dashboard', title: 'Dashboard' }) %>
<%
  const first = (user.name || 'there').split(' ')[0];
  const hr = new Date().getHours();
  const greet = hr < 12 ? 'Good morning' : hr < 17 ? 'Good afternoon' : 'Good evening';
  const live = meetings.find(m => m.status === 'live');
  const J = v => JSON.stringify(v).replace(/</g, '\\u003c');
  const cards = [
    ['calendar', 'Upcoming classes', stats.upcoming, ''],
    ['clipboard-list', 'Tasks to do', stats.pending, ''],
    ['check-circle-2', 'Completed', stats.done, ''],
    ['award', 'Average score', stats.avg, '%']
  ];
%>
<section class="hero on-grad reveal">
  <div class="grow">
    <span class="hero-tag">Student space</span>
    <h2><%= greet %>, <%= first %> 👋</h2>
    <p><% if (live) { %><b><%= live.title %></b> is live right now — jump in!<% } else if (stats.pending) { %>You have <b><%= stats.pending %></b> task<%= stats.pending > 1 ? 's' : '' %> waiting. Let's get them done.<% } else { %>You're all caught up. Great work!<% } %></p>
    <div class="row wrap mt-s">
      <% if (live) { %><a class="btn btn-white" href="/meeting/<%= live.meetingCode %>"><span class="live-dot"></span> Join live class</a><% } else { %><a class="btn btn-white" href="/participant/meetings"><i data-lucide="video"></i> Browse classes</a><% } %>
      <a class="btn btn-ghost" href="/assignment/my-assignments"><i data-lucide="clipboard-list"></i> My tasks</a>
    </div>
  </div>
  <div class="ring-wrap">
    <svg class="ring" viewBox="0 0 42 42" width="104" height="104"><circle class="ring-bg" cx="21" cy="21" r="16" pathLength="100"/><circle class="ring-fg" cx="21" cy="21" r="16" pathLength="100" stroke-dasharray="<%= stats.completion %> 100"/></svg>
    <b><%= stats.completion %>%</b>
  </div>
</section>

<section class="grid g4 mt">
  <% cards.forEach((c, i) => { %>
    <div class="card stat reveal" style="transition-delay:<%= i * 70 %>ms">
      <span class="ico"><i data-lucide="<%= c[0] %>"></i></span>
      <b><span data-count="<%= c[2] %>">0</span><%= c[3] %></b>
      <span class="muted small"><%= c[1] %></span>
    </div>
  <% }) %>
</section>

<section class="grid g-main mt">
  <div class="col">
    <div class="card reveal">
      <div class="card-h"><h3>Your classes</h3><a class="link" href="/participant/meetings">View all →</a></div>
      <% meetings.slice(0, 5).forEach(m => { %>
        <div class="item">
          <span class="ico"><i data-lucide="<%= m.status === 'live' ? 'radio' : 'video' %>"></i></span>
          <div class="grow"><b class="truncate" style="display:block"><%= m.title %></b><span class="muted small truncate" style="display:block"><%= m.chapterName || 'Class' %> · <%= m.host ? m.host.name : '' %></span></div>
          <% if (m.status === 'live') { %><span class="badge b-red"><span class="live-dot"></span>Live</span><% } %>
          <a class="btn <%= m.status === 'live' ? 'btn-primary' : 'btn-ghost' %> btn-sm" href="/meeting/<%= m.meetingCode %>"><%= m.status === 'live' ? 'Join' : 'Open' %></a>
        </div>
      <% }) %>
      <% if (!meetings.length) { %><div class="empty"><div class="ico"><i data-lucide="video-off"></i></div>No classes right now.</div><% } %>
    </div>

    <div class="card reveal">
      <div class="card-h"><h3>Performance</h3><span class="muted small">Last graded tasks</span></div>
      <% if (chart.data.length) { %><div class="chart"><canvas id="perfChart"></canvas></div>
      <% } else { %><div class="empty"><div class="ico"><i data-lucide="line-chart"></i></div>Your scores will appear here after your first graded task.</div><% } %>
    </div>
  </div>

  <div class="col">
    <div class="card reveal">
      <div class="card-h"><h3>Tasks to do</h3><a class="link" href="/assignment/my-assignments">All →</a></div>
      <% pending.forEach(a => { %>
        <div class="item">
          <div class="grow"><b class="truncate" style="display:block"><%= a.title %></b>
            <span class="muted small"><%= a.type.replace('_', ' ') %> · <%= a.count %> Qs<%= a.dueDate ? ' · due ' + new Date(a.dueDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) : '' %></span></div>
          <% if (a.overdue) { %><span class="badge b-red">Overdue</span><% } %>
          <a class="btn btn-soft btn-sm" href="/assignment/take/<%= a._id %>">Start</a>
        </div>
      <% }) %>
      <% if (!pending.length) { %><div class="empty">🎉 Nothing pending</div><% } %>
    </div>

    <div class="card reveal">
      <div class="card-h"><h3>Class rank</h3><a class="link" href="/participant/leaderboard">Leaderboard →</a></div>
      <% if (stats.rank) { %>
        <div class="row"><span class="ico" style="width:56px;height:56px;font-size:20px;font-weight:800">#<%= stats.rank %></span>
          <div><b style="font-size:18px">Rank <%= stats.rank %> of <%= stats.ranked %></b><div class="muted small">Based on your graded tasks</div></div></div>
      <% } else { %><p class="muted">Get a task graded to join the leaderboard.</p><% } %>
    </div>

    <div class="card reveal">
      <div class="card-h"><h3>Recent results</h3></div>
      <% recent.forEach(r => { %>
        <div class="item"><div class="grow"><b class="truncate" style="display:block"><%= r.title %></b><span class="muted small"><%= r.score %>/<%= r.max %> points</span></div>
          <span class="badge <%= r.pct >= 75 ? 'b-green' : r.pct >= 50 ? 'b-amber' : 'b-red' %>"><%= r.pct %>%</span></div>
      <% }) %>
      <% if (!recent.length) { %><div class="empty-s">No results yet</div><% } %>
    </div>
  </div>
</section>

<script>
(function () {
  var el = document.getElementById('perfChart'); if (!el || !window.Chart) return;
  var a1 = cssVar('--a1'), g = el.getContext('2d').createLinearGradient(0, 0, 0, 230);
  g.addColorStop(0, a1 + '66'); g.addColorStop(1, a1 + '00');
  new Chart(el, { type: 'line',
    data: { labels: <%- J(chart.labels) %>, datasets: [{ data: <%- J(chart.data) %>, borderColor: a1, backgroundColor: g, fill: true, tension: .4, pointRadius: 4, pointBackgroundColor: a1 }] },
    options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { min: 0, max: 100, ticks: { callback: function (v) { return v + '%'; } } }, x: { grid: { display: false } } } } });
})();
</script>
<%- include('../partials/shell-bottom') %>