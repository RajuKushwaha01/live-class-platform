<%- include('../partials/shell-top', { role: 'host', active: 'students', title: 'Students' }) %>
<div class="page-head">
  <div><span class="badge b-accent">People</span><h2>My students</h2><p class="muted"><%= rows.length %> student<%= rows.length === 1 ? '' : 's' %> have joined your classes.</p></div>
  <a class="btn btn-soft" href="/host/students/export"><i data-lucide="download"></i> Export CSV</a>
</div>
<div class="toolbar"><div class="searchbox"><i data-lucide="search"></i><input class="input" data-search-for="#stList" placeholder="Search name or email…" /></div></div>

<div class="card">
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th>Student</th><th>Classes</th><th>Tasks graded</th><th>Average</th></tr></thead>
    <tbody id="stList" data-list>
      <% rows.forEach(r => { %>
        <tr data-item data-status="all">
          <td><div class="row"><span class="avatar"><%= (r.name || '?').slice(0, 1).toUpperCase() %></span><div><b><%= r.name %></b><div class="muted small"><%= r.email %></div></div></div></td>
          <td><%= r.classes %></td><td><%= r.tasks %></td>
          <td style="min-width:170px"><% if (r.avg === null) { %><span class="muted">—</span><% } else { %><div class="row"><div class="progress grow"><i style="width:<%= r.avg %>%"></i></div><b><%= r.avg %>%</b></div><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <div class="empty" data-empty-for="#stList" <%= rows.length ? 'hidden' : '' %>><div class="ico"><i data-lucide="users"></i></div>No students yet. Share a meeting link to get started.</div>
</div>
<%- include('../partials/shell-bottom') %>