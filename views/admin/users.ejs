<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>Manage Users — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/animations.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="relative min-h-screen">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <%- include('../partials/sidebar', { role: 'admin', active: 'students' }) %>

  <main class="ml-64 p-8 relative z-10 page-fade-in">
    <h1 class="text-white text-3xl font-bold mb-6">👥 Manage Users</h1>

    <div class="glass-card overflow-hidden">
      <table class="responsive-table w-full text-left text-sm">
        <thead class="bg-white/10 text-gray-300">
          <tr>
            <th class="p-4">Name</th>
            <th class="p-4">Email</th>
            <th class="p-4">Role</th>
            <th class="p-4">Status</th>
            <th class="p-4">Actions</th>
          </tr>
        </thead>
        <tbody class="text-white">
          <% users.forEach(u => { %>
            <tr class="border-t border-white/10">
              <td class="p-4" data-label="Name"><%= u.name %></td>
              <td class="p-4 text-gray-400" data-label="Email"><%= u.email %></td>
              <td class="p-4 capitalize" data-label="Role"><%= u.role %></td>
              <td class="p-4" data-label="Status">
                <% if (u.isBlocked) { %>
                  <span class="bg-red-500/20 text-red-400 text-xs px-3 py-1 rounded-full">Blocked</span>
                <% } else { %>
                  <span class="bg-green-500/20 text-green-400 text-xs px-3 py-1 rounded-full">Active</span>
                <% } %>
              </td>
              <td class="p-4 flex gap-2 justify-end md:justify-start" data-label="Actions">
                <form action="/admin/users/<%= u._id %>/toggle-block" method="POST">
                  <button class="text-xs px-3 py-1.5 rounded-lg <%= u.isBlocked ? 'bg-green-600 hover:bg-green-500' : 'bg-yellow-600 hover:bg-yellow-500' %> text-white transition">
                    <%= u.isBlocked ? "Unblock" : "Block" %>
                  </button>
                </form>
                <form action="/admin/users/<%= u._id %>/delete" method="POST" onsubmit="return confirm('Delete this user permanently?')">
                  <button class="text-xs px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white transition">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <script>lucide.createIcons();</script>
</body>
</html>